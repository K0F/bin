SHM_SIG="/dev/shm/signature"
if [ ! -L /home/kof/.signature ]; then
  rm -f /home/kof/.signature
  ln -s "$SHM_SIG" /home/kof/.signature
fi

while true; do
  {
    echo "Kryštof Pešek"
    #echo "https://k0f.github.io"
    echo "-----------------------------------------"
    echo "Moon phase  : $(/home/kof/bin/moonphase)"
    #echo "Metric time : $(/home/kof/bin/metriclock)"
    echo "Unix epoch  : $(date +%s)"
    echo `/home/kof/src/metricTime/dh | tail -n 2 | head -n 1`
  } > "${SHM_SIG}.tmp" && mv -f "${SHM_SIG}.tmp" "$SHM_SIG"

  sleep 1.2
done
