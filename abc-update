#!/bin/bash
# abc-update — Polní updater a diagnostika pro divadelní instalaci 1938ABC (phaser / t520)
# Symlink: divadlo-update

set -euo pipefail

REPO_DIR="${ABC_REPO_DIR:-$HOME/src/1938ABC}"

die() {
    echo "CHYBA: $*" >&2
    exit 1
}

ensure_repo() {
    [ -d "$REPO_DIR/.git" ] || die "Repozitář 1938ABC nenalezen v $REPO_DIR"
}

resolve_ssh_dest() {
    local target="${1:-}"
    if [ -n "$target" ]; then
        case "$target" in
            *@*|boxa*|boxb*) printf '%s\n' "$target" ;;
            *) printf 'pi@%s\n' "$target" ;;
        esac
        return 0
    fi
    return 1
}

detect_boxa_target() {
    local ip
    for ip in 192.168.88.104 192.168.8.104; do
        if timeout 1 bash -c "exec 3<>/dev/tcp/$ip/22" 2>/dev/null; then
            printf '%s\n' "$ip"
            return 0
        fi
    done
    if ssh -o BatchMode=yes -o ConnectTimeout=3 pesek.com "ss -tln 2>/dev/null | grep -q ':2224 '" 2>/dev/null; then
        printf '%s\n' "boxa-tunnel"
        return 0
    fi
    return 1
}

cmd_help() {
    cat <<'EOF'
abc-update (divadlo-update) — polní updater pro 1938ABC (Box A / Box B)

Použití:
  abc-update status          Stav repozitáře, samplů, WiFi, tunelu a SD karty
  abc-update pull            Stáhne novinky (origin -> pesek -> github) a dekóduje WAV
  abc-update sd [CÍL]        Bezpečně aktualizuje SD kartu Boxu A ze čtečky
  abc-update ssh [CÍL]       Aktualizuje běžící Box A přes síť / SSH tunel
  abc-update scan            Prohledá aktuální WiFi subnet na SSH porty (22)
  abc-update vnc [CÍL]       Otevře VNC náhled kamery Boxu A přes SSH tunel (:5900)
  abc-update logs [CÍL]      Sleduje živý log (tracker + box-autossh) na Boxu A
  abc-update help            Vypíše tuto nápovědu

Výchozí pořadí cílů pro ssh/vnc/logs bez argumentu:
  1) 192.168.88.104 (divadelní WiFi cafe)
  2) 192.168.8.104  (domácí router HUAWEI)
  3) boxa-tunnel    (reverzní SSH tunel přes pesek.com:2224)
EOF
}

cmd_pull() {
    ensure_repo
    local remote="" r
    for r in origin pesek github; do
        if git -C "$REPO_DIR" remote get-url "$r" >/dev/null 2>&1; then
            if timeout 8 git -C "$REPO_DIR" fetch "$r" main >/dev/null 2>&1; then
                remote="$r"
                break
            fi
        fi
    done
    if [ -z "$remote" ]; then
        die "Nepodařilo se spojit se žádným remote (origin, pesek, github)."
    fi
    echo "== Stahuji aktualizace z remote '$remote' =="
    git -C "$REPO_DIR" pull --ff-only "$remote" main
    echo "== Dekóduji samply (Opus -> 24kHz mono WAV) =="
    "$REPO_DIR/samples-decode.sh"
}

cmd_status() {
    ensure_repo
    local branch rev wav_count opus_count f wifi_info ip_info root_dev root_disk
    branch="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    rev="$(git -C "$REPO_DIR" log -1 --format='%h %s' 2>/dev/null || echo '?')"
    wav_count="$(find "$REPO_DIR/samples" -maxdepth 1 -type f -name '*.wav' 2>/dev/null | wc -l | tr -d ' ')"
    opus_count="$(find "$REPO_DIR/samples" -maxdepth 1 -type f -name '*.opus' 2>/dev/null | wc -l | tr -d ' ')"

    echo "=== 1938ABC Divadelní Updater ($(hostname)) ==="
    echo "Repo:       $REPO_DIR [$branch @ $rev]"
    echo "Samply:     $opus_count .opus / $wav_count .wav"

    for f in box-network.defaults box_tunnel_key box_tunnel_key.pub map.csv; do
        if [ -f "$REPO_DIR/$f" ]; then
            echo "Soubor OK:  $f ($(stat -c '%a' "$REPO_DIR/$f"))"
        else
            echo "CHYBÍ:      $f"
        fi
    done

    echo ""
    echo "--- Síť a dostupnost ---"
    wifi_info="$(nmcli -t -f ACTIVE,SSID,DEVICE dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2 " (" $3 ")"}' | head -n1 || true)"
    ip_info="$(ip -4 -br addr show 2>/dev/null | awk '$2=="UP"{print $1 ": " $3}' | paste -sd '; ' - || true)"
    echo "WiFi:       ${wifi_info:-nepřipojeno}"
    echo "IPv4:       ${ip_info:-žádná}"

    for target_info in "boxa-abc (192.168.88.104):192.168.88.104" "boxa (192.168.8.104):192.168.8.104"; do
        local label="${target_info%%:*}"
        local tip="${target_info##*:}"
        if timeout 1 bash -c "exec 3<>/dev/tcp/$tip/22" 2>/dev/null; then
            echo "SSH $label: DOSTUPNÝ"
        else
            echo "SSH $label: nedostupný"
        fi
    done

    if ssh -o BatchMode=yes -o ConnectTimeout=3 pesek.com "hostname" >/dev/null 2>&1; then
        echo "pesek.com:  DOSTUPNÝ"
        if ssh -o BatchMode=yes -o ConnectTimeout=3 pesek.com "ss -tln 2>/dev/null | grep -q ':2224 '" 2>/dev/null; then
            echo "Tunel 2224: AKTIVNÍ (boxa-tunnel připraven)"
        else
            echo "Tunel 2224: neaktivní"
        fi
    elif ssh -o BatchMode=yes -o ConnectTimeout=2 -p 2222 kof@192.168.1.101 "hostname" >/dev/null 2>&1; then
        echo "pesek.com:  nedostupný z domácí LAN (bez hairpin NAT; boxC:2222 v LAN OK)"
        if ssh -o BatchMode=yes -o ConnectTimeout=2 -p 2222 kof@192.168.1.101 "ss -tln 2>/dev/null | grep -q ':2224 '" 2>/dev/null; then
            echo "Tunel 2224: AKTIVNÍ na boxC"
        else
            echo "Tunel 2224: neaktivní"
        fi
    else
        echo "pesek.com:  nedostupný"
    fi

    echo ""
    echo "--- Vyměnitelná média / SD čtečka ---"
    root_dev="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
    root_disk="$(lsblk -no PKNAME "$root_dev" 2>/dev/null | head -n1 || true)"
    lsblk -nrpo NAME,SIZE,LABEL,FSTYPE,MOUNTPOINT,PKNAME 2>/dev/null | awk -F' ' -v rd="$root_dev" -v rdisk="$root_disk" '
        $1 == rd { next }
        rdisk != "" && ($1 == ("/dev/" rdisk) || $6 == rdisk) { next }
        $1 ~ /boot0$|boot1$|zram/ { next }
        { printf "  %-14s %-6s label=%-10s fs=%-8s mnt=%s\n", $1, $2, ($3==""?"-":$3), ($4==""?"-":$4), ($5==""?"-":$5); found=1 }
        END { if (!found) print "  (žádná externí SD karta / USB disk)" }
    '
}

cmd_sd() {
    ensure_repo
    echo "== Zkouším stáhnout nejnovější verzi (offline nevadí) =="
    if ! cmd_pull 2>/dev/null; then
        echo "  (offline režim: pokračuji s lokálním stavem v $REPO_DIR)"
        "$REPO_DIR/samples-decode.sh" || true
    fi
    sudo "$REPO_DIR/update-boxa-sd.sh" "$@"
}

cmd_ssh() {
    ensure_repo
    local target="${1:-}"
    if [ -z "$target" ]; then
        target="$(detect_boxa_target || true)"
        [ -n "$target" ] || die "Box A není dostupný na 192.168.88.104, 192.168.8.104 ani přes boxa-tunnel."
        echo "Automaticky zvolen cíl: $target"
    fi
    "$REPO_DIR/update-boxa-ssh.sh" "$target"
}

cmd_scan() {
    command -v nmap >/dev/null 2>&1 || die "nmap není nainstalován"
    local cidr
    cidr="$(ip -4 -o addr show scope global 2>/dev/null | awk 'NR==1{print $4}')"
    [ -n "$cidr" ] || die "Nenalezena žádná aktivní IPv4 síť"
    echo "== Skenuji $cidr pro otevřený port 22 (SSH) =="
    nmap -p 22 --open -T4 "$cidr"
}

cmd_vnc() {
    ensure_repo
    command -v vncviewer >/dev/null 2>&1 || die "vncviewer (tigervnc-viewer) není nainstalován"
    local target="${1:-}" dest="" tun_pid=""
    if [ -z "$target" ]; then
        target="$(detect_boxa_target || true)"
        [ -n "$target" ] || die "Box A není dostupný na 192.168.88.104, 192.168.8.104 ani přes boxa-tunnel."
    fi
    dest="$(resolve_ssh_dest "$target")"

    cleanup_vnc() {
        if [ -n "$tun_pid" ] && kill -0 "$tun_pid" 2>/dev/null; then
            kill "$tun_pid" 2>/dev/null || true
        fi
        if [ -n "$dest" ]; then
            echo "== Ukončuji tracker-vnc a vracím bezhlavý tracker.service na $dest =="
            ssh -o ConnectTimeout=5 "$dest" "sudo systemctl stop tracker-vnc && sudo systemctl start tracker.service" || true
        fi
    }
    trap cleanup_vnc EXIT INT TERM

    echo "== Spouštím tracker-vnc na $dest =="
    ssh -o ConnectTimeout=5 "$dest" "sudo systemctl start tracker-vnc"
    sleep 2

    echo "== Otevírám SSH tunel localhost:5900 -> $dest:5900 =="
    ssh -o ExitOnForwardFailure=yes -N -L 5900:127.0.0.1:5900 "$dest" &
    tun_pid="$!"
    sleep 1

    echo "== Spouštím vncviewer (výchozí heslo: tracker) =="
    vncviewer 127.0.0.1:5900 || true
}

cmd_logs() {
    local target="${1:-}" dest=""
    if [ -z "$target" ]; then
        target="$(detect_boxa_target || true)"
        [ -n "$target" ] || die "Box A není dostupný na 192.168.88.104, 192.168.8.104 ani přes boxa-tunnel."
    fi
    dest="$(resolve_ssh_dest "$target")"
    echo "== Sleduji logy na $dest (Ctrl+C pro ukončení) =="
    exec ssh -t "$dest" "journalctl -u tracker -u box-autossh -f"
}

SUBCMD="${1:-help}"
shift 2>/dev/null || true

case "$SUBCMD" in
    status)      cmd_status "$@" ;;
    pull)        cmd_pull "$@" ;;
    sd)          cmd_sd "$@" ;;
    ssh)         cmd_ssh "$@" ;;
    scan)        cmd_scan "$@" ;;
    vnc)         cmd_vnc "$@" ;;
    logs)        cmd_logs "$@" ;;
    help|-h|--help) cmd_help ;;
    *)           echo "Neznámý příkaz: $SUBCMD" >&2; cmd_help >&2; exit 2 ;;
esac
