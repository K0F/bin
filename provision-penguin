#!/usr/bin/env bash
# provision-phaser: Onboard or update phaser (Debian 13 Chromebook) once powered on and reachable
set -euo pipefail

PHASER_IP="${1:-192.168.1.25}"

echo "[provision-phaser] Checking connectivity to phaser ($PHASER_IP)..."
if ! ping -c 1 -W 2 "$PHASER_IP" &>/dev/null; then
    echo "[provision-phaser] Error: phaser ($PHASER_IP) is currently offline / unreachable."
    exit 1
fi

echo "[provision-phaser] Updating ~/bin, identity, and SuperCollider on phaser..."
ssh -o ConnectTimeout=5 "kof@$PHASER_IP" '
git -C ~/bin pull origin main
sudo bash -c "cat << CONF > /etc/fleet_id
# Fleet Node Identification
FLEET_NODE=\"phaser\"
FLEET_ARCH=\"x86_64\"
FLEET_SIGN=\"[phaser:x86_64]\"
CONF
chmod 644 /etc/fleet_id"

grep -q "bin-env" ~/.zshenv 2>/dev/null || echo "[ -f \"\$HOME/bin/bin-env\" ] && source \"\$HOME/bin/bin-env\"" >> ~/.zshenv
grep -q "bin-env" ~/.bashrc 2>/dev/null || echo "[ -f \"\$HOME/bin/bin-env\" ] && source \"\$HOME/bin/bin-env\"" >> ~/.bashrc
grep -q "bin-env" ~/.zshrc 2>/dev/null || echo "[ -f \"\$HOME/bin/bin-env\" ] && source \"\$HOME/bin/bin-env\"" >> ~/.zshrc

~/bin/fleet-id
~/bin/setup-sc-node
'
echo "[provision-phaser] Complete."
