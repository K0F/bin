#!/usr/bin/env bash
# /home/kof/bin/drop
# Drops entire /24 subnet for suspicious IP addresses via nftables.
set -euo pipefail

IP="${1:-}"
if [[ -z "$IP" ]]; then
  echo "Usage: $0 <IPv4-address>"
  exit 2
fi

# validate basic IPv4 format
if ! [[ "$IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "Invalid IPv4 address: $IP"
  exit 2
fi

IFS=. read -r o1 o2 o3 o4 <<< "$IP"
for oct in "$o1" "$o2" "$o3" "$o4"; do
  if (( oct < 0 || oct > 255 )); then
    echo "Invalid IPv4 address octet: $oct"
    exit 2
  fi
done

# Safety invariant: NEVER drop fleet, loopback, or private subnets!
if (( o1 == 127 )) || \
   (( o1 == 10 )) || \
   (( o1 == 192 && o2 == 168 )) || \
   (( o1 == 172 && o2 >= 16 && o2 <= 31 )); then
  echo "Safety: Refusing to drop private/fleet IP: $IP"
  exit 0
fi

CIDR="${o1}.${o2}.${o3}.0/24"
echo "CIDR: $CIDR"

# add nftables rule (creates table/chain if missing)
if ! sudo nft list table ip filter >/dev/null 2>&1; then
  sudo nft add table ip filter
fi
if ! sudo nft list chain ip filter input >/dev/null 2>&1; then
  sudo nft "add chain ip filter input { type filter hook input priority 0; }"
fi

# Check if rule already exists to avoid redundant nft calls
if sudo nft list chain ip filter input 2>/dev/null | grep -Fq "ip saddr $CIDR drop"; then
  echo "CIDR $CIDR is already dropped in nftables."
  exit 0
fi

sudo nft -f - <<RULE_EOF
table ip filter {
  chain input {
    type filter hook input priority 0;
    ip saddr $CIDR drop
  }
}
RULE_EOF

echo "Added nftables rule to drop traffic from $CIDR"
