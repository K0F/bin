            "properties": {
                "task_id": {"type": "integer", "description": "ID úkolu."},
                "result": {"type": "string", "description": "Shrnutí výsledku nebo výstup."},
                "status": {"type": "string", "enum": ["done", "failed"], "description": "Výsledný stav (výchozí done)."}
            },
            "required": ["task_id"],
        },
    },
]


def mcp_reply(req_id, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": req_id}
    if error is not None:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def run_mcp():
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            req = json.loads(raw)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method", "")
        params = req.get("params") or {}

        if method == "initialize":
            mcp_reply(req_id, {
                "protocolVersion": "2024-11-05",
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "fleet-board", "version": "1.0.0"},
            })
        elif method == "notifications/initialized":
            continue
        elif method == "ping":
            mcp_reply(req_id, {})
        elif method == "tools/list":
            mcp_reply(req_id, {"tools": MCP_TOOLS})
        elif method == "tools/call":
            name = params.get("name")
            args = params.get("arguments") or {}
            try:
                if name == "board_status":
                    res = op_status(limit_posts=int(args.get("limit_posts", 10)))
                elif name == "board_post":
                    res = op_post(args["message"], author=args.get("author"))
                elif name == "board_add_task":
                    res = op_add_task(args["title"], target_node=args.get("target_node", "any"), payload=args.get("payload", ""))
                elif name == "board_claim_task":
                    res = op_claim_task(node=args.get("node")) or {"message": "Žádný čekající úkol pro tento uzel."}
                elif name == "board_complete_task":
                    res = op_complete_task(args["task_id"], result=args.get("result", ""), status=args.get("status", "done")) or {"error": "Úkol nenalezen."}
                else:
                    mcp_reply(req_id, error={"code": -32601, "message": f"Unknown tool: {name}"})
                    continue
                mcp_reply(req_id, {
                    "content": [{"type": "text", "text": json.dumps(res, indent=2, ensure_ascii=False)}]
                })
            except Exception as e:
                mcp_reply(req_id, {
                    "isError": True,
                    "content": [{"type": "text", "text": f"Chyba fleet-board: {e}"}],
                })
        elif req_id is not None:
            mcp_reply(req_id, error={"code": -32601, "message": f"Method not found: {method}"})


def format_human_status(st):
    lines = [f"=== FLEET BOARD ({st['board_path']}) | self={st['self_node']} ==="]
    lines.append("Nodes:")
    for n, info in sorted(st["nodes"].items()):
        lines.append(f"  - {n:8s} {info.get('state','?')} (last_seen {info.get('last_seen','?')})")
    lines.append(f"Tasks ({len(st['tasks'])}):")
    for t in st["tasks"]:
        own = f" [{t['owner']}]" if t.get("owner") else ""
        res = f" -> {t['result']}" if t.get("result") else ""
        lines.append(f"  #{t['id']} [{t['status']}] -> @{t['target_node']}{own}: {t['title']}{res}")
    lines.append(f"Recent Posts ({len(st['posts'])}):")
    for p in st["posts"]:
        lines.append(f"  [{p['ts']}] {p['author']}: {p['message']}")
    return "\n".join(lines)


def main():
    p = argparse.ArgumentParser(description="Společný board a fronta úkolů flotily")
    p.add_argument("--mcp", action="store_true", help="Spustit jako MCP stdio server")
    p.add_argument("--json", action="store_true", help="Výstup v JSON")
    sub = p.add_subparsers(dest="cmd")

    s_st = sub.add_parser("status", help="Stav boardu")
    s_st.add_argument("-n", "--limit", type=int, default=10)

    s_post = sub.add_parser("post", help="Zpráva na nástěnku")
    s_post.add_argument("message")

    s_add = sub.add_parser("add", help="Přidat úkol")
    s_add.add_argument("title")
    s_add.add_argument("--to", default="any", help="t520 | bazina | boxC | any")
    s_add.add_argument("--payload", default="")

    s_claim = sub.add_parser("claim", help="Vyzvednout další úkol pro uzel")
    s_claim.add_argument("node", nargs="?", default=None)

    s_done = sub.add_parser("done", help="Dokončit úkol")
    s_done.add_argument("id", type=int)
    s_done.add_argument("result", nargs="?", default="OK")

    s_fail = sub.add_parser("fail", help="Označit úkol jako neúspěšný")
    s_fail.add_argument("id", type=int)
    s_fail.add_argument("result", nargs="?", default="FAILED")

    sub.add_parser("clear-done", help="Smazat hotové/neúspěšné úkoly")

    args = p.parse_args()
    if args.mcp:
        run_mcp()
        return

    cmd = args.cmd or "status"
    if cmd == "status":
        res = op_status(limit_posts=getattr(args, "limit", 10))
        print(json.dumps(res, indent=2, ensure_ascii=False) if args.json else format_human_status(res))
    elif cmd == "post":
        res = op_post(args.message)
        print(json.dumps(res, indent=2, ensure_ascii=False))
    elif cmd == "add":
        res = op_add_task(args.title, target_node=args.to, payload=args.payload)
        print(json.dumps(res, indent=2, ensure_ascii=False))
    elif cmd == "claim":
        res = op_claim_task(node=args.node)
        print(json.dumps(res, indent=2, ensure_ascii=False))
    elif cmd == "done":
        res = op_complete_task(args.id, result=args.result, status="done")
        print(json.dumps(res, indent=2, ensure_ascii=False))
    elif cmd == "fail":
        res = op_complete_task(args.id, result=args.result, status="failed")
        print(json.dumps(res, indent=2, ensure_ascii=False))
    elif cmd == "clear-done":
        res = op_clear_done()
        print(json.dumps(res, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
