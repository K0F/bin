#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
fleet-board — Společný board a fronta úkolů pro Antigravity & agenty flotily (t520, bazina/permafrost, boxC).
Recykluje sdílené úložiště (/mnt/data/.fleet_board.json), UDP beacon (port 9850) a ~/bin/fleet-context.
Podporuje jak CLI rozhraní, tak nativní MCP stdio server (--mcp) bez externích závislostí.
"""

import argparse
import fcntl
import json
import os
import socket
import subprocess
import sys
import time
from contextlib import contextmanager

BOARD_PATH = os.environ.get("FLEET_BOARD_PATH", "/mnt/data/.fleet_board.json")
FALLBACK_PATH = os.path.expanduser("~/.local/share/fleet_board.json")
LOCK_SUFFIX = ".lock"
BEACON_PORT = 9850
BEACON_TARGETS = ["<broadcast>", "10.0.0.255", "192.168.1.255", "10.39.9.255", "127.0.0.1"]

NODE_ALIASES = {
    "permafrost": "bazina",
    "bazina": "bazina",
    "t520": "t520",
    "boxc": "boxC",
    "boxC": "boxC",
    "android": "android",
    "phone": "android",
    "termux": "android",
    "phaser": "phaser",
    "crostini": "phaser",
    "penguin": "phaser",
}


def get_node():
    h = socket.gethostname().split(".")[0]
    return NODE_ALIASES.get(h, NODE_ALIASES.get(h.lower(), h))


def norm_node(name):
    if not name:
        return "any"
    return NODE_ALIASES.get(name, NODE_ALIASES.get(name.lower(), name))


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def resolve_board_path():
    parent = os.path.dirname(BOARD_PATH)
    if os.path.isdir(parent) and os.access(parent, os.W_OK):
        return BOARD_PATH
    os.makedirs(os.path.dirname(FALLBACK_PATH), exist_ok=True)
    return FALLBACK_PATH


@contextmanager
def board_lock(path):
    lock_path = path + LOCK_SUFFIX
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o666)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def load_board(path):
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    data.setdefault("tasks", [])
                    data.setdefault("posts", [])
                    data.setdefault("lessons", [])
                    data.setdefault("next_id", 1)
                    data.setdefault("nodes", {})
                    return data
        except Exception:
            pass
    return {"next_id": 1, "nodes": {}, "tasks": [], "posts": [], "lessons": []}


def save_board(path, data):
    tmp = f"{path}.tmp.{socket.gethostname()}.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
    try:
        os.chmod(tmp, 0o666)
    except Exception:
        pass
    os.replace(tmp, path)


def broadcast_event(event_type, summary):
    pkt = json.dumps({
        "type": "fleet_board",
        "event": event_type,
        "node": get_node(),
        "ts": int(time.time()),
        "summary": summary[:200],
    }, ensure_ascii=False).encode("utf-8")
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for t in BEACON_TARGETS:
            try:
                s.sendto(pkt, (t, BEACON_PORT))
            except Exception:
                pass
        s.close()
    except Exception:
        pass

    fc = os.path.expanduser("~/bin/fleet-context")
    if os.path.exists(fc):
        try:
            subprocess.Popen(
                [fc, "set", "board_last_event", f"[{get_node()}] {summary[:140]}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass


def touch_node(data, node=None, state="online"):
    n = norm_node(node or get_node())
    data["nodes"][n] = {"last_seen": now_iso(), "epoch": int(time.time()), "state": state}


def op_status(limit_posts=10):
    path = resolve_board_path()
    with board_lock(path):
        data = load_board(path)
        touch_node(data)
        save_board(path, data)
    return {
        "board_path": path,
        "self_node": get_node(),
        "nodes": data["nodes"],
        "tasks": data["tasks"],
        "posts": data["posts"][-limit_posts:],
        "lessons": data["lessons"][-5:],
    }


def op_learn(topic, lesson, tags=""):
    path = resolve_board_path()
    node = get_node()
    with board_lock(path):
        data = load_board(path)
        touch_node(data, node)
        lid = len(data["lessons"]) + 1
        entry = {
            "id": lid,
            "ts": now_iso(),
            "node": node,
            "topic": topic,
            "lesson": lesson,
            "tags": tags,
        }
        data["lessons"].append(entry)
        data["lessons"] = data["lessons"][-200:]
        data["posts"].append({
            "ts": entry["ts"],
            "node": node,
            "author": f"agent@{node}",
            "message": f"[LEARN #{lid}] {topic}: {lesson}",
        })
        data["posts"] = data["posts"][-100:]
        save_board(path, data)
    # Zrcadlit do /mnt/data/src/fleet_knowledge.md pro všechny uzly i lokální Qwen
    kb_path = os.path.join(os.path.dirname(path), "src", "fleet_knowledge.md")
    try:
        os.makedirs(os.path.dirname(kb_path), exist_ok=True)
        with open(kb_path, "a", encoding="utf-8") as kf:
            tag_str = f" `{tags}`" if tags else ""
            kf.write(f"- **[{entry['ts']}] ({node}) {topic}**{tag_str}: {lesson}\n")
    except Exception:
        pass
    broadcast_event("learn", f"{topic}: {lesson}")
    return entry


def op_lessons(limit=20, query=""):
    path = resolve_board_path()
    with board_lock(path):
        data = load_board(path)
    items = data.get("lessons", [])
    if query:
        q = query.lower()
        items = [x for x in items if q in x.get("topic", "").lower() or q in x.get("lesson", "").lower() or q in x.get("tags", "").lower()]
    return items[-limit:]


def op_post(message, author=None):
    path = resolve_board_path()
    node = get_node()
    with board_lock(path):
        data = load_board(path)
        touch_node(data, node)
        entry = {
            "ts": now_iso(),
            "node": node,
            "author": author or f"agent@{node}",
            "message": message,
        }
        data["posts"].append(entry)
        data["posts"] = data["posts"][-100:]
        save_board(path, data)
    broadcast_event("post", f"{entry['author']}: {message}")
    return entry


def op_add_task(title, target_node="any", payload="", created_by=None):
    path = resolve_board_path()
    node = get_node()
    tgt = norm_node(target_node)
    with board_lock(path):
        data = load_board(path)
        touch_node(data, node)
        tid = data["next_id"]
        data["next_id"] = tid + 1
        task = {
            "id": tid,
            "title": title,
            "target_node": tgt,
            "status": "todo",
            "owner": None,
            "payload": payload,
            "result": "",
            "created_by": created_by or f"agent@{node}",
            "created_at": now_iso(),
            "updated_at": now_iso(),
        }
        data["tasks"].append(task)
        save_board(path, data)
    broadcast_event("task_add", f"#{tid} -> @{tgt}: {title}")
    return task


def op_claim_task(node=None, owner=None):
    path = resolve_board_path()
    n = norm_node(node or get_node())
    with board_lock(path):
        data = load_board(path)
        touch_node(data, n)
        claimed = None
        # Nejprve úkoly cílené přímo na tento uzel, pak "any"
        for wanted in (n, "any"):
            for t in data["tasks"]:
                if t["status"] == "todo" and t["target_node"] == wanted:
                    t["status"] = "in_progress"
                    t["owner"] = owner or f"agent@{n}"
                    t["updated_at"] = now_iso()
                    claimed = t
                    break
            if claimed:
                break
        save_board(path, data)
    if claimed:
        broadcast_event("task_claim", f"#{claimed['id']} claimed by @{n}")
    return claimed


def op_complete_task(task_id, result="", status="done"):
    path = resolve_board_path()
    n = get_node()
    with board_lock(path):
        data = load_board(path)
        touch_node(data, n)
        target = None
        for t in data["tasks"]:
            if int(t["id"]) == int(task_id):
                t["status"] = status
                t["result"] = result
                t["updated_at"] = now_iso()
                target = t
                break
        save_board(path, data)
    if target:
        broadcast_event(f"task_{status}", f"#{task_id} {status} by @{n}: {result}")
    return target


def op_clear_done():
    path = resolve_board_path()
    with board_lock(path):
        data = load_board(path)
        before = len(data["tasks"])
        data["tasks"] = [t for t in data["tasks"] if t["status"] in ("todo", "in_progress")]
        removed = before - len(data["tasks"])
        save_board(path, data)
    return {"removed": removed, "remaining": len(data["tasks"])}


# ---------- Semafor / zámky nad /mnt/data/src/.locks ----------

LOCKS_DIR = os.environ.get("FLEET_LOCKS_DIR", "/mnt/data/src/.locks")


def _safe_res_name(resource):
    return "".join(c if c.isalnum() or c in "._-" else "_" for c in resource).strip("_") or "default"


def op_locks():
    if not os.path.isdir(LOCKS_DIR):
        return []
    now_ts = time.time()
    out = []
    for fn in sorted(os.listdir(LOCKS_DIR)):
        if not fn.endswith(".lock"):
            continue
        lp = os.path.join(LOCKS_DIR, fn)
        try:
            info = json.load(open(lp, "r", encoding="utf-8"))
            info["expired"] = now_ts > float(info.get("expires_at", 0))
            out.append(info)
        except Exception:
            out.append({"resource": fn[:-5], "error": "unreadable"})
    return out


def op_lock(resource, ttl=300):
    os.makedirs(LOCKS_DIR, exist_ok=True)
    res_name = _safe_res_name(resource)
    lp = os.path.join(LOCKS_DIR, f"{res_name}.lock")
    node = get_node()
    now_ts = time.time()
    payload = {
        "resource": res_name,
        "owner": node,
        "pid": os.getpid(),
        "acquired_at": now_iso(),
        "expires_at": now_ts + int(ttl),
    }
    for _ in range(2):
        try:
            fd = os.open(lp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o666)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(payload, f, ensure_ascii=False)
            broadcast_event("lock", f"LOCK {res_name} by @{node} ({ttl}s)")
            return {"acquired": True, **payload}
        except FileExistsError:
            try:
                cur = json.load(open(lp, "r", encoding="utf-8"))
                if now_ts > float(cur.get("expires_at", 0)) or cur.get("owner") == node:
                    os.unlink(lp)
                    continue
                return {"acquired": False, "held_by": cur}
            except Exception:
                return {"acquired": False, "error": "lock_exists"}
    return {"acquired": False}


def op_unlock(resource, force=False):
    res_name = _safe_res_name(resource)
    lp = os.path.join(LOCKS_DIR, f"{res_name}.lock")
    if not os.path.exists(lp):
        return {"unlocked": True, "resource": res_name, "note": "not_locked"}
    node = get_node()
    try:
        cur = json.load(open(lp, "r", encoding="utf-8"))
        if not force and cur.get("owner") != node and time.time() <= float(cur.get("expires_at", 0)):
            return {"unlocked": False, "held_by": cur}
    except Exception:
        pass
    os.unlink(lp)
    broadcast_event("unlock", f"UNLOCK {res_name} by @{node}")
    return {"unlocked": True, "resource": res_name}


