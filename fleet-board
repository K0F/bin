        "description": "Vrátí aktuální stav společného boardu flotily (aktivní uzly t520/bazina/boxC, frontu úkolů a poslední zprávy na nástěnce).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "limit_posts": {"type": "integer", "description": "Kolik posledních zpráv z nástěnky vrátit (výchozí 10)."}
            },
        },
    },
    {
        "name": "board_post",
        "description": "Odešle zprávu na společnou nástěnku flotily viditelnou pro všechny uzly (t520, bazina, boxC).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "message": {"type": "string", "description": "Text zprávy (lze použít @t520, @bazina, @boxC, @all)."},
                "author": {"type": "string", "description": "Volitelný podpis autora."}
            },
            "required": ["message"],
        },
    },
    {
        "name": "board_add_task",
        "description": "Přidá nový úkol na společný board a přiřadí ho konkrétnímu uzlu (t520, bazina, boxC) nebo libovolnému (any).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "title": {"type": "string", "description": "Krátký popis úkolu."},
                "target_node": {"type": "string", "enum": ["t520", "bazina", "boxC", "any"], "description": "Cílový uzel flotily."},
                "payload": {"type": "string", "description": "Volitelný detail, příkaz nebo kontext úkolu."}
