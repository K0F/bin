        ])
    paste_monitor(boxc_img, 3760, 546, "BOXC (RIGHT) // RASPBERRY PI 4 VPN & STORAGE", "192.168.1.101 [1024x768]")

    # Traversal Vectors (Synergy KVM Traversal Lines)
    arrow_color = (255, 190, 40) # Bright Amber
    
    # t520 <---> boxC
    draw.line([(2060 + 1600 + 14, 480 + 450), (3760 - 14, 546 + 384)], fill=arrow_color, width=3)
    draw.text((3700 - 80, 500), "<=== Synergy KVM ===>", fill=arrow_color)

    # t520 <---> penguin
    draw.line([(2060 - 14, 480 + 450), (60 + 1366 + 14, 1340 + 200)], fill=arrow_color, width=3)
    draw.text((1520, 880), "<=== Synergy KVM ===>", fill=arrow_color)

    # t520 <---> bazina
    draw.line([(2060 + 400, 480 - 14), (60 + 1600, 160 + 1080 + 14)], fill=arrow_color, width=3)
    draw.text((1700, 300), "<=== Synergy KVM ===>", fill=arrow_color)

    # bazina <---> penguin
    draw.line([(60 + 600, 160 + 1080 + 14), (60 + 600, 1340 - 14)], fill=arrow_color, width=3)
    draw.text((60 + 620, 1260), "KVM <^>", fill=arrow_color)

    # bazina <---> boxC
    draw.line([(60 + 1920 + 14, 160 + 300), (3760 - 14, 546 + 200)], fill=(100, 180, 255), width=2)
    draw.text((2900, 220), "<-- NFSv4 Gigabit Link (/mnt/ssd, /mnt/kof17) -->", fill=(100, 180, 255))

    # Bottom Context Footer Bar (Aggregated from ~/src/dnes)
    draw.rectangle([(0, CANVAS_H - 130), (CANVAS_W, CANVAS_H)], fill=(12, 15, 20), outline=(40, 50, 65), width=2)
    draw.text((36, CANVAS_H - 118), "POSLEDNÍ ZÁPISY A MILNÍKY Z REPOZITÁŘE DNES (JOURNAL.MD):", fill=(255, 220, 80))
    
    col1_x = 36
    col2_x = CANVAS_W // 2
    for i, m in enumerate(ctx["recent_milestones"][:6]):
        target_x = col1_x if i < 3 else col2_x
        target_y = CANVAS_H - 92 + (i % 3) * 26
        # clean milestone text
        clean_m = m if len(m) < 140 else m[:137] + "..."
        draw.text((target_x, target_y), clean_m, fill=(200, 215, 235))

    # Save files
    out_png = os.path.join(AGENTS_DIR, "fleet_canvas.png")
    out_jpg = os.path.join(AGENTS_DIR, "fleet_canvas.jpg")
    out_md = os.path.join(AGENTS_DIR, "fleet_canvas.md")

    print(f"[*] Saving master canvas to {out_png}...")
    canvas.save(out_png, "PNG", optimize=True)

    # Also save 0.5x preview JPEG for small-web viewing
    print(f"[*] Saving preview JPEG to {out_jpg}...")
    preview = canvas.resize((CANVAS_W // 2, CANVAS_H // 2), Image.Resampling.LANCZOS)
    preview.save(out_jpg, "JPEG", quality=88)

    # Write Markdown documentation
    with open(out_md, "w", encoding="utf-8") as f:
        f.write(f"""# The Observatoř Fleet // Physical Display Canvas Matrix

Vygenerováno: {ctx['time_str']}
