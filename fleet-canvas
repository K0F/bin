def render_canvas(screens, ctx):
    print("[*] Composing physical display canvas matrix...")
    
    # Canvas dimensions
    CANVAS_W = 4920
    CANVAS_H = 2280
    BG_COLOR = (20, 24, 30)
    GRID_COLOR = (30, 36, 46)
    
    canvas = Image.new("RGB", (CANVAS_W, CANVAS_H), BG_COLOR)
    draw = ImageDraw.Draw(canvas)
    
    # Draw desk blueprint grid
    for x in range(0, CANVAS_W, 60):
        draw.line([(x, 0), (x, CANVAS_H)], fill=GRID_COLOR, width=1)
    for y in range(0, CANVAS_H, 60):
        draw.line([(0, y), (CANVAS_W, y)], fill=GRID_COLOR, width=1)

    # Header Bar
