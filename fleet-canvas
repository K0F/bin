        boxc_img = Image.open(screens["boxC"]).convert("RGB")
    else:
        boxc_img = create_placeholder_card("BOXC [RIGHT]", 1024, 768, "192.168.1.101", [
            "Hardware: Raspberry Pi 4 Model B (4GB RAM)",
            "OS: Debian GNU/Linux 12 (Bookworm aarch64)",
            "Display: PiJockey HDMI CRTC scanout (1024x768)",
