# 1. Capture Screenshots
def capture_fleet_screenshots():
    print("[*] Capturing screenshots across fleet nodes...")
    
    # t520 local
    t520_path = "/tmp/scrot_t520.png"
    try:
        subprocess.run(["scrot", "-z", "-o", t520_path], check=True, env=dict(os.environ, DISPLAY=":0"))
        print(f"  [✓] t520: captured ({t520_path})")
    except Exception as e:
        print(f"  [-] t520 scrot error: {e}")

    # bazina remote
    bazina_path = "/tmp/scrot_bazina.png"
    try:
        cmd = 'DISPLAY=:0 scrot -z -o /tmp/scrot_bazina.png 2>/dev/null || DISPLAY=:0 XAUTHORITY=/home/kof/.Xauthority scrot -z -o /tmp/scrot_bazina.png'
        subprocess.run(["ssh", "-o", "ConnectTimeout=3", "bazina", cmd], check=True, timeout=5)
        subprocess.run(["scp", "-o", "ConnectTimeout=3", "bazina:/tmp/scrot_bazina.png", bazina_path], check=True, timeout=5)
        print(f"  [✓] bazina: captured and transferred ({bazina_path})")
    except Exception as e:
        print(f"  [-] bazina scrot error: {e}")

    # boxC remote
    boxc_path = "/tmp/scrot_boxc.png"
    try:
        cmd = 'DISPLAY=:0 scrot -z -o /tmp/scrot_boxc.png 2>/dev/null || sudo -u root DISPLAY=:0 scrot -z -o /tmp/scrot_boxc.png'
        subprocess.run(["ssh", "-o", "ConnectTimeout=3", "boxC", cmd], check=True, timeout=5)
        subprocess.run(["scp", "-o", "ConnectTimeout=3", "boxC:/tmp/scrot_boxc.png", boxc_path], check=True, timeout=5)
        print(f"  [✓] boxC: captured and transferred ({boxc_path})")
    except Exception as e:
        print(f"  [-] boxC scrot error: {e}")

    return {
        "t520": t520_path if os.path.exists(t520_path) else None,
        "bazina": bazina_path if os.path.exists(bazina_path) else None,
        "boxC": boxc_path if os.path.exists(boxc_path) else None
    }

# 2. Harvest Context from ~/src/dnes
def harvest_dnes_context():
    journal_path = os.path.join(HOME, "src", "dnes", "journal.md")
    milestones = []
    if os.path.exists(journal_path):
        with open(journal_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line.startswith("- ["):
                    milestones.append(line)
    
    # Moonphase
    moon_summary = "🌘 Ubývající srpek (15.4% osvětlení)"
    try:
        res = subprocess.run(["python3", "-c", "import sys; sys.path.insert(0, os.path.expanduser('~/bin')); import moonphase; print(moonphase.get_moon_metrics().get('summary'))"], capture_output=True, text=True)
        if res.stdout.strip():
            moon_summary = res.stdout.strip()
    except Exception:
        pass

    return {
        "recent_milestones": milestones[-8:] if milestones else [],
        "moon_summary": moon_summary,
        "time_str": datetime.now().strftime("%Y-%m-%d %H:%M:%S CET")
    }

# 3. Create Placeholder Screen Card
def create_placeholder_card(title, width, height, ip, details):
    img = Image.new("RGB", (width, height), (18, 22, 28))
    draw = ImageDraw.Draw(img)
    
    # Grid lines
    for x in range(0, width, 40):
        draw.line([(x, 0), (x, height)], fill=(28, 34, 44), width=1)
    for y in range(0, height, 40):
        draw.line([(0, y), (width, y)], fill=(28, 34, 44), width=1)

    # Frame border
    draw.rectangle([(2, 2), (width - 3, height - 3)], outline=(60, 80, 110), width=2)

    # Title bar
    draw.rectangle([(2, 2), (width - 3, 34)], fill=(32, 45, 62))
    draw.text((12, 8), title, fill=(220, 235, 255))
    draw.text((width - 140, 8), ip, fill=(120, 190, 255))

    # Center terminal box
    tw, th = int(width * 0.85), int(height * 0.65)
    tx, ty = (width - tw) // 2, (height - th) // 2 + 10
    draw.rectangle([(tx, ty), (tx + tw, ty + th)], fill=(10, 12, 16), outline=(45, 60, 80), width=2)
    
    # Text inside terminal
    y_text = ty + 18
    draw.text((tx + 20, y_text), f"$ fleet-node-telemetry --node={title.split()[0].lower()}", fill=(120, 255, 120))
    y_text += 26
    for line in details:
        draw.text((tx + 20, y_text), line, fill=(180, 200, 220))
        y_text += 22

    # Status indicator
    draw.ellipse([(tx + tw - 24, ty + 12), (tx + tw - 12, ty + 24)], fill=(0, 230, 120))
    return img

