    draw.text((36, 20), "THE OBSERVATOŘ FLEET // PHYSICAL DISPLAY CANVAS MATRIX", fill=(255, 255, 255))
    draw.text((36, 54), f"SYNERGY KVM 5-NODE MULTI-HEAD MESH ⨂ {ctx['time_str']} ⨂ {ctx['moon_summary']}", fill=(121, 172, 228)) # FCZ blue #79ACE4
    draw.text((36, 80), "PTP GRANDMASTER (Intel 82579LM ±6ns) ⨂ 50.000 Hz EU GRID TELEMETRY ⨂ ARCHER VR400 192.168.1.0/24", fill=(160, 175, 195))

    # Top right badges
    draw.rectangle([(CANVAS_W - 540, 20), (CANVAS_W - 36, 90)], fill=(18, 24, 34), outline=(70, 90, 120), width=1)
    draw.text((CANVAS_W - 520, 32), "FLEET NETWORK HIERARCHY:", fill=(255, 220, 100))
    draw.text((CANVAS_W - 520, 52), "L1: LAN 192.168.1.0/24 (Gigabit + WiFi)", fill=(200, 220, 240))
    draw.text((CANVAS_W - 520, 70), "L2: WireGuard 10.39.9.0/24 · L3: OpenVPN", fill=(140, 180, 220))

    # Monitor Bezel & Stand helper
    def paste_monitor(img, x, y, title, badge, is_server=False):
        mw, mh = img.size
        bw = 14 # Bezel thickness
        # Bezel frame
        bezel_x1, bezel_y1 = x - bw, y - bw - 28
        bezel_x2, bezel_y2 = x + mw + bw, y + mh + bw + 14
        
        # Outer shadow
        draw.rectangle([(bezel_x1 + 6, bezel_y1 + 6), (bezel_x2 + 6, bezel_y2 + 6)], fill=(10, 12, 16))
        # Bezel body
        bezel_color = (35, 42, 52) if not is_server else (45, 56, 70)
        draw.rectangle([(bezel_x1, bezel_y1), (bezel_x2, bezel_y2)], fill=bezel_color, outline=(70, 85, 105), width=2)
        
        # Title bar on bezel
        draw.text((bezel_x1 + 14, bezel_y1 + 6), title, fill=(255, 255, 255))
        draw.text((bezel_x2 - len(badge)*8 - 14, bezel_y1 + 6), badge, fill=(120, 220, 160) if not is_server else (255, 200, 80))
        
        # Power LED
        draw.ellipse([(bezel_x2 - 18, bezel_y2 - 12), (bezel_x2 - 8, bezel_y2 - 2)], fill=(0, 255, 130))

        # Paste actual screen
        canvas.paste(img, (x, y))

        # Desk stand
        sw, sh = 120, 30
        sx = x + (mw - sw) // 2
        draw.rectangle([(sx, bezel_y2), (sx + sw, bezel_y2 + 10)], fill=(50, 60, 75))
        draw.rectangle([(sx - 30, bezel_y2 + 10), (sx + sw + 30, bezel_y2 + 18)], fill=(30, 36, 45), outline=(60, 75, 95), width=1)

    # 1. BAZINA (Left-Top)
    bazina_img = None
    if screens.get("bazina") and os.path.exists(screens["bazina"]):
        bazina_img = Image.open(screens["bazina"]).convert("RGB")
    else:
        bazina_img = create_placeholder_card("BAZINA [LEFT-TOP]", 1920, 1080, "192.168.1.104", [
            "OS: Debian GNU/Linux 13 (Trixie)",
            "CPU: AMD Ryzen 5 3600 (6c/12t) @ 4.2 GHz",
            "GPU: AMD Radeon RX 5600/5700 XT (Navi 10)",
            "Audio: ASUS VX248 HDMI (WirePlumber p1500)",
            "NBD Swap Server: 8GB tmpfs ramdisk -> t520",
            "Print/Scan: Brother DCP-J4120DW (CUPS 600 DPI)",
            "Storage: /mnt/ssd (1TB NVMe), /mnt/seagate (1TB)"
        ])
    paste_monitor(bazina_img, 60, 160, "BAZINA (LEFT-TOP) // AMD RYZEN + RX 5700 XT", "192.168.1.104 [1920x1080]")

    # 2. PENGUIN (Left-Bottom)
    penguin_img = create_placeholder_card("PENGUIN [LEFT-BOTTOM]", 1366, 768, "192.168.1.105", [
        "Hardware: Chromebook Field Node",
        "Identity: crostini [x86_64 Debian container]",
        "Role: Mobile field terminal & documentation",
        "Synergy KVM: Client connected (bottom-left)",
        "NTP: Synchronized to t520 Stratum 1 Grandmaster",
        "Network: 192.168.1.105 (WiFi) / 10.39.9.105 (WG)",
        "Physical placement: Left of t520 under bazina"
    ])
    paste_monitor(penguin_img, 60, 1340, "PENGUIN (LEFT-BOTTOM) // CHROMEBOOK FIELD NODE", "192.168.1.105 [1366x768]")

    # 3. ANDROID (Under table left)
    android_img = create_placeholder_card("ANDROID [PHONE]", 470, 768, "192.168.1.103", [
        "Device: Xiaomi 22101316G",
        "OS: Android 14 / Termux aarch64",
        "Port: 8022 (u0_a322)",
        "Sensors: OSC 9000/8000 -> bazina",
        "Sync: Syncthing phone-DCIM",
        "Status: Pod stolem vlevo"
    ])
    paste_monitor(android_img, 60 + 1366 + 84, 1340, "ANDROID // TERMUX aarch64", "192.168.1.103:8022")

    # 4. T520 (Center KVM Server)
    t520_img = None
    if screens.get("t520") and os.path.exists(screens["t520"]):
        t520_img = Image.open(screens["t520"]).convert("RGB")
    else:
        t520_img = create_placeholder_card("T520 [CENTER / SERVER]", 1600, 900, "192.168.1.100", [
            "Hardware: ThinkPad t520 (Intel i5-2520M)",
            "OS: Arch Linux x86_64",
            "Role: Synergy KVM Server (Port 24800)",
            "IEEE 1588 PTP Grandmaster: Intel 82579LM (/dev/ptp0)",
            "SDR Heat Scanner: RTL-SDR 868.95 MHz Wireless M-Bus",
            "Memory: 8GB zram0 (zstd) + 8GB NBD RAM swap bazina",
            "Power/ACPI: S3 freeze disabled, lid mute hook active"
        ])
    paste_monitor(t520_img, 2060, 480, "T520 (CENTER SERVER / GRANDMASTER) // THINKPAD T520", "192.168.1.100 [1600x900]", is_server=True)

    # 5. BOXC (Right Node)
    boxc_img = None
