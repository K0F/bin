#!/usr/bin/env bash
# =============================================================================
# ~/bin/dock-t520 — Re-couple t520 into the fleet spaghetti monster upon return
# =============================================================================
set -euo pipefail

echo "========================================================"
echo " [FLEET] t520 Dock Protocol: Re-coupling to Desk Rig"
echo "========================================================"

NODE="$(uname -n)"

if [ "$NODE" = "t520" ]; then
    echo "[*] Running locally on t520..."
    
    # 1. Remount NFS
    echo "[1/3] Remounting NFS /mnt/data from boxC..."
    sudo mount /mnt/data 2>/dev/null || true
    
    # 2. Restart Synergy server and clients
    echo "[2/3] Restarting Synergy fleet..."
    ~/bin/synergy-fleet restart 2>/dev/null || true
    
    # 3. Synchronize git repositories
    echo "[3/3] Syncing repositories..."
    if command -v sync-src >/dev/null 2>&1; then
        sync-src 2>/dev/null || true
    fi

else
    echo "[*] Triggering dock protocol on t520 remotely..."
    T520_IP="${T520_IP:-10.39.10.3}"
    ssh -o BatchMode=yes -o ConnectTimeout=3 "$T520_IP" "bash -s" <<'EOF'
        sudo mount /mnt/data 2>/dev/null || true
        ~/bin/synergy-fleet restart 2>/dev/null || true
EOF
    echo "[*] Restarting local synergy client on $(uname -n)..."
    ~/bin/synergy-fleet client 2>/dev/null || true
fi

echo "--------------------------------------------------------"
echo "[✓] t520 is fully re-coupled into the fleet matrix."
echo "========================================================"

if command -v now >/dev/null 2>&1; then
    now "[FLEET/DOCK] t520 successfully re-docked to desk matrix" 2>/dev/null || true
fi
if command -v dnes >/dev/null 2>&1; then
    dnes done "t520 znovu připojen k docku a synchronizován (dock-t520)" 2>/dev/null || true
fi
