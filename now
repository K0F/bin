#!/bin/bash

# Check if category tag is provided, e.g. [TAG] or "[TAG] message"
if [[ "$1" =~ ^\[([^]]+)\][[:space:]]*(.*)$ ]]; then
    CATEGORY="${BASH_REMATCH[1]^^}"
    REST="${BASH_REMATCH[2]}"
    shift
    if [ -n "$REST" ]; then
        ARGS="$REST${*:+ }$*"
    else
        ARGS="$*"
    fi
else
    CATEGORY="GENERAL"
    ARGS="$*"
fi

# Generate timestamp
TS=$(date +%s.%N)

# Log to file
echo "$TS [$CATEGORY] $ARGS" >> /home/kof/src/now/log

# Print to stdout
echo "$TS"

# Git operations
cd /home/kof/src/now
git commit -am "$TS [$CATEGORY] $ARGS"
git pull
git push

