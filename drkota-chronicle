def cmd_warp(args):
    """
    Timewarp replay and simulation mode (using timewarp-alpine / libtimewarp rate scaling).
    Supports numeric rate (e.g. 60.0 for 1 hr/min, -60.0 for retrograde) or 'palindrome'.
    """
    rate_arg = args.rate.lower().strip() if isinstance(args.rate, str) else str(args.rate)
    now_ts = time.time()

    is_palindrome = (rate_arg in ["palindrome", "p", "decan"])
    try:
        rate_val = 1.0 if is_palindrome else float(rate_arg)
    except ValueError:
        print(f"[-] Neplatná rychlost timewarpu: '{rate_arg}'. Použijte číslo (např. 60, -1) nebo 'palindrome'.")
        sys.exit(1)

    print(f"[*] Inicializuji Timewarp Chronograf:")
    if is_palindrome:
        print(f"    • Režim: PALINDROMICKÁ DEKANICKÁ VLNA (1/36 dne = 2400 s / 10° rotace Země)")
        # Calculate triangle wave phase
        half_p = 2400.0
        phase = math.fmod(now_ts, 2.0 * half_p)
        offset = phase if phase <= half_p else (2.0 * half_p - phase)
        sim_ts = now_ts + (offset - half_p / 2.0)
    else:
        print(f"    • Režim: LINEÁRNÍ ŠKÁLOVÁNÍ ČASU (dT/dτ = {rate_val:+.2f} s/s)")
        if rate_val < 0:
            print(f"    • Směr : ▼ RETROGRÁDNÍ TOK ČASU (procházení historie zpět v čase)")
        else:
            print(f"    • Směr : ▲ PROGRÁDNÍ TOK ČASU (zrychlená simulace dopředu)")
        # Simulate jump of 1 hour scaled by rate
        sim_ts = now_ts + (rate_val * 360.0)

    telemetry = harvest_all(target_ts=sim_ts, warp_rate=rate_val)
    telemetry["scenario"] = f"WARP[{rate_arg.upper()}]"

    svg_data, w, h = generate_strip_svg(telemetry, width_mm=args.width, height_mm=args.height)
    out_path = args.svg_only if args.svg_only else f"/tmp/drkota_warp_{rate_arg}_{int(time.time())}.svg"
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(svg_data)

    print(f"[+] Timewarp chronogram vygenerován pro virtuální čas T = {telemetry['time']['cet_str']} CET")
    dispatch_plot(out_path, args, mode="warp")

