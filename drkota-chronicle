def cmd_realtime(args):
    """
    Realtime ticker / continuous monitoring daemon.
    Periodically samples telemetry and updates the live chronogram.
    """
    interval = args.interval
    max_count = args.count
    print(f"[*] Spouštím Realtime Telemetrický Ticker pro Drkotu:")
    print(f"    • Vzorkovací interval: {interval} s")
    print(f"    • Maximální počet    : {max_count if max_count > 0 else 'nekonečno (Ctrl+C pro ukončení)'}")

    iteration = 0
    try:
        while True:
            iteration += 1
            telemetry = harvest_all()
            t_str = telemetry["time"]["cet_time"]
            dh = telemetry["time"]["dh36"]["str"]
            hz = telemetry["grid"]["freq_hz"]
            drift = telemetry["grid"]["drift_mhz"]
            hca = telemetry["heat"]["total_units"]
            tc = telemetry["weather"]["temp_c"]

            out_path = args.svg_only if args.svg_only else "/tmp/drkota_chronicle_live.svg"
            svg_data, _, _ = generate_stamp_svg(telemetry)
            with open(out_path, "w", encoding="utf-8") as f:
                f.write(svg_data)

            print(f"[{iteration:03d} | {t_str}] DH36: {dh} | Síť: {hz:.3f} Hz ({drift:+.1f} mHz) | Otop: {hca:.0f} HCA | Meteo: {tc:+.1f}°C -> {out_path}")

            if args.plot and not args.dry_run:
                dispatch_plot(out_path, args, mode="realtime")

            if max_count > 0 and iteration >= max_count:
                print("[+] Dosažen maximální počet vzorků. Ukončuji.")
                break

            time.sleep(interval)
    except KeyboardInterrupt:
        print("\n[*] Realtime ticker přerušen operátorem. Časové razidlo uloženo.")

