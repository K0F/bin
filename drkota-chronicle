def render_text_strokes(text, x, y, char_w=1.6, char_h=2.5, char_gap=0.45, align='left'):
    """
    Renders string into a list of SVG path segments (M/L) in millimeter coordinates.
    Handles Czech accents, symbols, and case-insensitivity without KeyErrors.
    """
    sx = char_w / 40.0
    sy = char_h / 50.0
    step_x = char_w + char_gap
    total_w = len(text) * step_x

    start_x = x
    if align == 'center':
        start_x = x - total_w / 2.0
    elif align == 'right':
        start_x = x - total_w

    paths = []
    cursor_x = start_x

    for ch in text:
        if ch == ' ':
            cursor_x += step_x * 0.85
            continue

        lookup_ch = ch.upper()
        # Fallback mappings
        if lookup_ch not in ALPHABET:
            # Try unaccented or simplified
            mapping = {'é': 'E', 'è': 'E', 'ë': 'E', 'ä': 'A', 'ö': 'O', 'ü': 'U', 'č': 'Č', 'š': 'Š', 'ž': 'Ž'}
            lookup_ch = mapping.get(ch, lookup_ch)
            if lookup_ch not in ALPHABET:
                lookup_ch = '?'

        strokes = ALPHABET.get(lookup_ch, [])
        for st in strokes:
            pts = [(cursor_x + px * sx, y + py * sy) for (px, py) in st]
            if pts:
                d = f"M {pts[0][0]:.2f},{pts[0][1]:.2f} " + " ".join(
                    f"L {p[0]:.2f},{p[1]:.2f}" for p in pts[1:]
                )
                paths.append(d)

        cursor_x += step_x

    return paths

