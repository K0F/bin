# ==============================================================================
# Vector Path Primitives (Paths compatible with GoMotor & SVG)
# ==============================================================================

def path_circle(cx, cy, r, segments=36):
    pts = []
    for i in range(segments + 1):
        a = 2.0 * math.pi * i / segments
        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
    return f"M {pts[0][0]:.2f},{pts[0][1]:.2f} " + " ".join(f"L {p[0]:.2f},{p[1]:.2f}" for p in pts[1:])

def path_line(x1, y1, x2, y2):
    return f"M {x1:.2f},{y1:.2f} L {x2:.2f},{y2:.2f}"

def path_rect(x, y, w, h):
    return f"M {x:.2f},{y:.2f} L {x+w:.2f},{y:.2f} L {x+w:.2f},{y+h:.2f} L {x:.2f},{y+h:.2f} Z"

def path_arc(cx, cy, r, start_rad, end_rad, segments=24):
    pts = []
    span = end_rad - start_rad
    for i in range(segments + 1):
        a = start_rad + span * (i / float(segments))
        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
    return f"M {pts[0][0]:.2f},{pts[0][1]:.2f} " + " ".join(f"L {p[0]:.2f},{p[1]:.2f}" for p in pts[1:])

def path_lagrange_constellation(cx, cy, r_max, azimuth_deg, lunar_pos):
    """
    Renders the Three-Body Lagrange Constellation (Sun, Earth, Moon):
      - 3 celestial bodies: Earth (center), Sun (solar vector), Moon (synodic vector)
      - Always the two distant Lagrange points for each system:
          * Sun-Earth: L2 (deep space shadow) and L3 (anti-Earth beyond Sun)
          * Sun-Earth Trojans: L4 & L5 (equilateral vertices at +-60 deg)
          * Earth-Moon: L2M (beyond Moon far side)
      - Delicate vector constellation lines (asterism) connecting celestial equilibrium nodes
    """
    paths = []
    sun_rad = math.radians(azimuth_deg - 90.0)
    moon_rad = sun_rad + lunar_pos * 2.0 * math.pi

    # 1. Earth at center (circle with cross)
    r_earth = max(1.2, r_max * 0.08)
    paths.append(path_circle(cx, cy, r_earth, segments=16))
    paths.append(path_line(cx - r_earth, cy, cx + r_earth, cy))
    paths.append(path_line(cx, cy - r_earth, cx, cy + r_earth))

    # 2. Sun (SOL)
    d_sun = r_max * 0.55
    sx = cx + d_sun * math.cos(sun_rad)
    sy = cy + d_sun * math.sin(sun_rad)
    r_sun = max(1.5, r_max * 0.10)
    paths.append(path_circle(sx, sy, r_sun, segments=20))
    for ang in [0, math.pi/2, math.pi, 3*math.pi/2]:
        paths.append(path_line(sx + r_sun * math.cos(ang), sy + r_sun * math.sin(ang),
                               sx + (r_sun + 1.0) * math.cos(ang), sy + (r_sun + 1.0) * math.sin(ang)))
    paths.extend(render_text_strokes("SOL", sx + 1.8, sy - 1.8, char_w=0.8, char_h=1.2, align="left"))

    # 3. Moon (LUNA)
    d_moon = r_max * 0.32
    mx = cx + d_moon * math.cos(moon_rad)
    my = cy + d_moon * math.sin(moon_rad)
    r_moon = max(1.0, r_max * 0.06)
    paths.append(path_circle(mx, my, r_moon, segments=16))
    paths.extend(render_text_strokes("LUNA", mx + 1.5, my - 1.5, char_w=0.7, char_h=1.0, align="left"))

    # 4. Sun-Earth Distant Collinear Points: L2 (Night Shadow) and L3 (Anti-Earth)
    d_l2 = r_max * 0.78
    l2_rad = sun_rad + math.pi
    l2_x = cx + d_l2 * math.cos(l2_rad)
    l2_y = cy + d_l2 * math.sin(l2_rad)
    s_l2 = 1.2
    paths.append(f"M {l2_x:.2f},{l2_y-s_l2:.2f} L {l2_x+s_l2:.2f},{l2_y:.2f} L {l2_x:.2f},{l2_y+s_l2:.2f} L {l2_x-s_l2:.2f},{l2_y:.2f} Z")
    paths.extend(render_text_strokes("L2", l2_x + 1.6, l2_y - 1.3, char_w=0.8, char_h=1.2, align="left"))

    d_l3 = r_max * 0.85
    l3_rad = sun_rad
    l3_x = cx + d_l3 * math.cos(l3_rad)
    l3_y = cy + d_l3 * math.sin(l3_rad)
    s_l3 = 1.2
    paths.append(f"M {l3_x:.2f},{l3_y-s_l3:.2f} L {l3_x+s_l3:.2f},{l3_y:.2f} L {l3_x:.2f},{l3_y+s_l3:.2f} L {l3_x-s_l3:.2f},{l3_y:.2f} Z")
    paths.extend(render_text_strokes("L3", l3_x + 1.6, l3_y - 1.3, char_w=0.8, char_h=1.2, align="left"))

    # 5. Sun-Earth Distant Trojan Equilateral Points: L4 and L5 (+-60 deg)
    l4_rad = sun_rad + math.pi / 3.0
    l5_rad = sun_rad - math.pi / 3.0
    l4_x = cx + d_sun * math.cos(l4_rad)
    l4_y = cy + d_sun * math.sin(l4_rad)
    l5_x = cx + d_sun * math.cos(l5_rad)
    l5_y = cy + d_sun * math.sin(l5_rad)
    for px, py, lbl in [(l4_x, l4_y, "L4"), (l5_x, l5_y, "L5")]:
        paths.append(path_line(px - 1.0, py, px + 1.0, py))
        paths.append(path_line(px, py - 1.0, px, py + 1.0))
        paths.extend(render_text_strokes(lbl, px + 1.5, py - 1.3, char_w=0.75, char_h=1.1, align="left"))

    # 6. Earth-Moon Distant Lagrange point: L2M (beyond Moon far side)
    d_l2m = d_moon + r_max * 0.16
    l2m_x = cx + d_l2m * math.cos(moon_rad)
    l2m_y = cy + d_l2m * math.sin(moon_rad)
    paths.append(path_line(l2m_x - 0.7, l2m_y, l2m_x + 0.7, l2m_y))
    paths.append(path_line(l2m_x, l2m_y - 0.7, l2m_x, l2m_y + 0.7))
    paths.extend(render_text_strokes("L2M", l2m_x + 1.2, l2m_y - 1.0, char_w=0.6, char_h=0.9, align="left"))

    # 7. Constellation Asterism Lines (Čáry souhvězdí)
    paths.append(path_line(l3_x, l3_y, sx, sy))
    paths.append(path_line(sx, sy, cx, cy))
    paths.append(path_line(cx, cy, l2_x, l2_y))
    paths.append(path_line(sx, sy, l4_x, l4_y))
    paths.append(path_line(l4_x, l4_y, cx, cy))
    paths.append(path_line(sx, sy, l5_x, l5_y))
    paths.append(path_line(l5_x, l5_y, cx, cy))
    paths.append(path_line(cx, cy, mx, my))
    paths.append(path_line(mx, my, l2m_x, l2m_y))
    paths.append(path_arc(cx, cy, d_sun, min(l5_rad, l4_rad), max(l5_rad, l4_rad), segments=20))

    return paths

def path_moon_phase(cx, cy, r, lunar_pos):
    """
    Renders an astronomical vector moon disc with exact illuminated crescent/gibbous terminator.
    """
    paths = []
    # Outer circle
    paths.append(path_circle(cx, cy, r, segments=32))

    # Terminator curve
    # Waxing: 0 < pos < 0.5 (right side lit); Waning: 0.5 < pos < 1.0 (left side lit)
    k = math.cos(2.0 * math.pi * lunar_pos)
    term_pts = []
    steps = 18
    for i in range(steps + 1):
        # angle from top (-pi/2) to bottom (+pi/2)
        a = -math.pi / 2.0 + math.pi * i / steps
        tx = cx + r * k * math.cos(a)
        ty = cy + r * math.sin(a)
        term_pts.append((tx, ty))

    d_term = f"M {term_pts[0][0]:.2f},{term_pts[0][1]:.2f} " + " ".join(f"L {p[0]:.2f},{p[1]:.2f}" for p in term_pts[1:])
    paths.append(d_term)

    # Central fine reticle
    paths.append(f"M {cx-1.2:.2f},{cy:.2f} L {cx+1.2:.2f},{cy:.2f}")
    paths.append(f"M {cx:.2f},{cy-1.2:.2f} L {cx:.2f},{cy+1.2:.2f}")

    return paths

def path_astrolabe_dial(cx, cy, r, azimuth_deg, lunar_pos):
    """
    Generates a full circular Astrolabe Dial:
    - 36 Decan tick marks (10° arc = 1.0 dh36)
    - Cardinal ticks (0° North, 90° East, 180° South, 270° West) with letters N, E, S, W
    - Azimuth hand pointing to metric dh36 azimuth
    - Central vector moon phase disc
    """
    paths = []
    r_outer = r
    r_inner = r * 0.88
    r_hub = r * 0.28

    # Concentric outer circles
    paths.append(path_circle(cx, cy, r_outer, segments=48))
    paths.append(path_circle(cx, cy, r_inner, segments=48))
    paths.append(path_circle(cx, cy, r_inner * 0.76, segments=36))

    # 36 Decanic Ticks (Every 10°)
    for i in range(36):
        ang_deg = i * 10.0
        rad = math.radians(ang_deg - 90.0)  # 0 deg is North (top)
        cos_a = math.cos(rad)
        sin_a = math.sin(rad)

        is_cardinal = (i % 9 == 0)
        t_start = r_inner * 0.68 if is_cardinal else r_inner
        t_end = r_outer

        x1 = cx + t_start * cos_a
        y1 = cy + t_start * sin_a
        x2 = cx + t_end * cos_a
        y2 = cy + t_end * sin_a
        paths.append(path_line(x1, y1, x2, y2))

    # Cardinal labels N, E, S, W
    r_label = r_inner * 0.58
    paths.extend(render_text_strokes("N", cx, cy - r_label - 1.2, char_w=1.4, char_h=2.0, align="center"))
    paths.extend(render_text_strokes("E", cx + r_label, cy - 1.0, char_w=1.4, char_h=2.0, align="center"))
    paths.extend(render_text_strokes("S", cx, cy + r_label - 1.0, char_w=1.4, char_h=2.0, align="center"))
    paths.extend(render_text_strokes("W", cx - r_label, cy - 1.0, char_w=1.4, char_h=2.0, align="center"))

    # Three-Body Lagrange Constellation (Sun, Earth, Moon & L2, L3, L4, L5, L2M)
    paths.extend(path_lagrange_constellation(cx, cy, r_inner * 0.72, azimuth_deg, lunar_pos))

    # Azimuth Pointer (Hand from center to current dh36 azimuth)
    azim_rad = math.radians(azimuth_deg - 90.0)
    hx = cx + (r_inner * 0.94) * math.cos(azim_rad)
    hy = cy + (r_inner * 0.94) * math.sin(azim_rad)
    # Needle stem
    paths.append(path_line(cx + r_hub * math.cos(azim_rad), cy + r_hub * math.sin(azim_rad), hx, hy))
    # Arrow tip
    tip_ang1 = azim_rad + math.radians(150.0)
    tip_ang2 = azim_rad - math.radians(150.0)
    paths.append(path_line(hx, hy, hx + 3.0 * math.cos(tip_ang1), hy + 3.0 * math.sin(tip_ang1)))
    paths.append(path_line(hx, hy, hx + 3.0 * math.cos(tip_ang2), hy + 3.0 * math.sin(tip_ang2)))

    # Central Moon Phase disc
    paths.extend(path_moon_phase(cx, cy, r_hub, lunar_pos))

    return paths

