def main():
    parser = argparse.ArgumentParser(
        description="drkota-chronicle — Unified Timewarp + Grid + Weather + Heat + Časové Razidlo Engine"
    )
    subparsers = parser.add_subparsers(dest="command", required=True, help="Režim vykreslování / chronografu")

    # Global options for subcommands
    def add_common_args(p):
        p.add_argument("--svg-only", type=str, metavar="PATH", help="Pouze vygeneruje SVG do zadané cesty a skončí")
        p.add_argument("--dry-run", action="store_true", help="Simulační běh bez odeslání příkazů na motory Drkoty")
        p.add_argument("--plot", action="store_true", help="Fyzicky odešle vygenerovaný soubor na Drkotu (přes drkota plot)")
        p.add_argument("--scale", type=float, default=DEFAULT_DRKOTA_SCALE, help=f"Měřítko pro Drkotu (výchozí {DEFAULT_DRKOTA_SCALE})")
        p.add_argument("--center", action="store_true", help="Vystředí kresbu na kreslicí ploše Drkoty")
        p.add_argument("--json", action="store_true", help="Vypíše nasbíranou telemetrii ve formátu JSON")
        p.add_argument("-v", "--verbose", action="store_true", help="Podrobný diagnostický výpis")

    # stamp
    p_stamp = subparsers.add_parser("stamp", help="Generuje 'Časové razidlo' (astrolábové pečetidlo se zlatým řezem φ)")
    p_stamp.add_argument("--width", type=float, default=105.0, help="Šířka razidla v mm (výchozí 105 mm, výška = 105 / φ ~ 65 mm)")
    p_stamp.add_argument("--fork", type=str, help="Volitelná alternativní větev kauzality pro razidlo")
    add_common_args(p_stamp)

    # strip
    p_strip = subparsers.add_parser("strip", help="Generuje 3-stopý seismografický chronogram (Síť 50Hz + Meteo + Otop)")
    p_strip.add_argument("--width", type=float, default=140.0, help="Šířka seismografického pásu v mm (výchozí 140 mm)")
    p_strip.add_argument("--height", type=float, default=210.0, help="Výška seismografického pásu v mm (výchozí 210 mm = A5)")
    p_strip.add_argument("--fork", type=str, help="Volitelná alternativní větev kauzality pro seismograf")
    add_common_args(p_strip)

    # warp
    p_warp = subparsers.add_parser("warp", help="Přehrávání a simulace časových posunů a timewarpu")
    p_warp.add_argument("rate", default="1.0", nargs="?", help="Škála rychlosti času (např. 60 pro 60x, -60 pro retrográdní, nebo 'palindrome')")
    p_warp.add_argument("--width", type=float, default=140.0, help="Šířka v mm")
    p_warp.add_argument("--height", type=float, default=210.0, help="Výška v mm")
    add_common_args(p_warp)

    # fork
    p_fork = subparsers.add_parser("fork", help="Rozvětvení do alternativních scénářů (blackout, heatwave, solar_flare, deep_winter, borges)")
    p_fork.add_argument("scenario", choices=["blackout", "heatwave", "solar_flare", "deep_winter", "borges"],
                        help="Kauzální scénář alternativní reality")
    p_fork.add_argument("--width", type=float, default=120.0, help="Šířka razidla v mm")
    add_common_args(p_fork)

    # realtime
    p_realtime = subparsers.add_parser("realtime", help="Živý telemetrický ticker s periodickým vzorkováním")
    p_realtime.add_argument("--interval", type=float, default=60.0, help="Perioda vzorkování v sekundách (výchozí 60 s)")
    p_realtime.add_argument("--count", type=int, default=0, help="Počet iterací (0 = nekonečný běh)")
    add_common_args(p_realtime)

    args = parser.parse_args()

    if args.command == "stamp":
        cmd_stamp(args)
    elif args.command == "strip":
        cmd_strip(args)
    elif args.command == "warp":
        cmd_warp(args)
    elif args.command == "fork":
        cmd_fork(args)
    elif args.command == "realtime":
        cmd_realtime(args)

if __name__ == "__main__":
    main()
