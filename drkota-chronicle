def harvest_grid():
    """
    Harvests 50Hz continental European grid telemetry.
    1. /dev/shm/observator_status.json
    2. /dev/shm/grid50.json
    3. Live netzfrequenz.info API
    4. Nominal fallback
    """
    # 1. Observator status
    if os.path.exists(GRID_SHM_STATUS):
        try:
            with open(GRID_SHM_STATUS, "r") as f:
                d = json.load(f)
                hz = float(d.get("grid_freq", 50.0))
                drift = float(d.get("grid_drift_mhz", (hz - 50.0) * 1000.0))
                source = d.get("grid_source", "observator_shm")
                updated = d.get("grid_updated", datetime.now().strftime("%H:%M:%S"))
                return {
                    "freq_hz": round(hz, 3),
                    "drift_mhz": round(drift, 1),
                    "status": "LOCKED" if abs(drift) < 50.0 else "UNSTABLE",
                    "source": source,
                    "updated": updated
                }
        except Exception:
            pass

    # 2. Local grid50
    if os.path.exists(GRID_SHM_LOCAL):
        try:
            with open(GRID_SHM_LOCAL, "r") as f:
                d = json.load(f)
                hz = float(d.get("frequency_hz", 50.0))
                drift = float(d.get("drift_mhz", (hz - 50.0) * 1000.0))
                status = d.get("status", "LOCKED")
                return {
                    "freq_hz": round(hz, 3),
                    "drift_mhz": round(drift, 1),
                    "status": status,
                    "source": "grid50_local",
                    "updated": datetime.now().strftime("%H:%M:%S")
                }
        except Exception:
            pass

    # 3. Live netzfrequenz
    try:
        req = urllib.request.Request(GRID_NETZFREQUENZ_URL, headers={"User-Agent": "DrkotaChronicle/1.0"})
        with urllib.request.urlopen(req, timeout=1.8) as resp:
            val_str = resp.read().decode("utf-8").strip()
            hz = float(val_str)
            drift = (hz - 50.0) * 1000.0
            return {
                "freq_hz": round(hz, 3),
                "drift_mhz": round(drift, 1),
                "status": "LOCKED",
                "source": "netzfrequenz.info (live)",
                "updated": datetime.now().strftime("%H:%M:%S")
            }
    except Exception:
        pass

    # 4. Fallback
    return {
        "freq_hz": 50.000,
        "drift_mhz": 0.0,
        "status": "NOMINAL",
        "source": "nominal_fallback",
        "updated": datetime.now().strftime("%H:%M:%S")
    }

def harvest_heat():
    """
    Harvests Wireless M-Bus radiator heat telemetry.
    1. /dev/shm/heat_fleet_summary.json
    2. SQLite ~/src/observator/data/heat_meters.db
    3. Nominal fallback
    """
    # 1. SHM Summary
    if os.path.exists(HEAT_SHM_SUMMARY):
        try:
            with open(HEAT_SHM_SUMMARY, "r") as f:
                d = json.load(f)
                total_units = float(d.get("total_units", 3093.0))
                total_meters = int(d.get("total_meters", 19))
                meters = d.get("meters", [])
                return {
                    "total_units": total_units,
                    "total_meters": total_meters,
                    "meters": meters,
                    "source": "shm_fleet_summary"
                }
        except Exception:
            pass

    # 2. SQLite Database
    if os.path.exists(HEAT_DB_PATH):
        try:
            conn = sqlite3.connect(HEAT_DB_PATH)
            c = conn.cursor()
            c.execute("SELECT count(*), sum(last_hca) FROM meters;")
            row = c.fetchone()
            total_meters = row[0] or 19
            total_units = row[1] or 3093.0
            c.execute("SELECT id, room_label, last_hca FROM meters ORDER BY id;")
            meters_data = []
            for r in c.fetchall():
                meters_data.append({"id": r[0], "room_label": r[1] or f"Meter #{r[0]}", "last_hca": r[2] or 0.0})
            conn.close()
            return {
                "total_units": float(total_units),
                "total_meters": int(total_meters),
                "meters": meters_data,
                "source": "sqlite_db"
            }
        except Exception:
            pass

    # 3. Fallback
    dummy_meters = [{"id": 18466400 + i, "room_label": f"M{i+1}", "last_hca": 100.0 + (i * 27.5) % 220} for i in range(19)]
    return {
        "total_units": 3093.0,
        "total_meters": 19,
        "meters": dummy_meters,
        "source": "nominal_fallback"
    }

def harvest_weather():
    """
    Harvests Prague weather telemetry from Open-Meteo with local shm cache fallback.
    """
    cached = None
    cache_file = WEATHER_CACHE_PATH if os.path.exists(os.path.dirname(WEATHER_CACHE_PATH)) else WEATHER_CACHE_BACKUP
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                cached = json.load(f)
        except Exception:
            cached = None

    # Query Open-Meteo
    try:
        req = urllib.request.Request(OPEN_METEO_URL, headers={"User-Agent": "DrkotaChronicle/1.0"})
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            cur = data.get("current", {})
            temp = float(cur.get("temperature_2m", 9.5))
            rh = float(cur.get("relative_humidity_2m", 75))
            press = float(cur.get("surface_pressure", 975.0))
            wind = float(cur.get("wind_speed_10m", 15.0))

            res = {
                "temp_c": round(temp, 1),
                "rh_pct": int(rh),
                "pressure_hpa": round(press, 1),
                "wind_kmh": round(wind, 1),
                "source": "Open-Meteo Prague (live)",
                "timestamp": cur.get("time", datetime.now().isoformat())
            }
            try:
                with open(cache_file, "w") as f:
                    json.dump(res, f, indent=2)
            except Exception:
                pass
            return res
    except Exception:
        pass

    # Use cache if live query failed
    if cached and "temp_c" in cached:
        cached["source"] = "Open-Meteo (cached fallback)"
        return cached

    # Fallback
    return {
        "temp_c": 9.7,
        "rh_pct": 71,
        "pressure_hpa": 974.3,
        "wind_kmh": 17.6,
        "source": "nominal_fallback",
        "timestamp": datetime.now().isoformat()
    }

def harvest_time(target_ts=None):
    """
    Harvests decanic metric chronometry (dh36, decan, azimuth) and Meeus lunar phase.
    """
    if target_ts is None:
        now_dt = datetime.now()
        unix_ts = now_dt.timestamp()
    else:
        unix_ts = float(target_ts)
        now_dt = datetime.fromtimestamp(unix_ts)

    # 1. Decanic Harmonic Time (dh36)
    # Check binary first
    dh_info = None
    if os.path.exists(DH36_BIN) and os.access(DH36_BIN, os.X_OK):
        try:
            res = subprocess.run([DH36_BIN, "-j", str(unix_ts)], capture_output=True, text=True, timeout=1.5)
            if res.returncode == 0:
                d = json.loads(res.stdout)
                dh36 = d.get("dh36", {})
                dh_info = {
                    "str": dh36.get("str", "00.00.00"),
                    "float": dh36.get("float", 0.0),
                    "azimuth_deg": dh36.get("azimuth_deg", 0.0),
                    "cardinal": dh36.get("cardinal", "N"),
                    "decan": dh36.get("decan", 0),
                    "standard": d.get("standard", now_dt.strftime("%H:%M:%S"))
                }
        except Exception:
            pass

    if dh_info is None:
        # Exact Python decanic calculation
        secs = now_dt.hour * 3600.0 + now_dt.minute * 60.0 + now_dt.second + now_dt.microsecond / 1e6
        frac = secs / 86400.0
        val = frac * 36.0
        dh_h = int(val)
        rem_m = (val - dh_h) * 100.0
        dh_m = int(rem_m)
        dh_s = int((rem_m - dh_m) * 100.0)
        azimuth = frac * 360.0
        decan = dh_h
        # Cardinal direction
        cardinals = ["N (Midnight)", "NNE", "NE", "ENE", "E (Dawn / Sunrise)", "ESE", "SE", "SSE",
                     "S (Noon / Zenith)", "SSW", "SW", "WSW", "W (Dusk / Sunset)", "WNW", "NW", "NNW"]
        idx = int(math.floor(((azimuth + 11.25) % 360.0) / 22.5))
        cardinal = cardinals[idx % 16]

        dh_info = {
            "str": f"{dh_h:02d}.{dh_m:02d}.{dh_s:02d}",
            "float": round(val, 4),
            "azimuth_deg": round(azimuth, 2),
            "cardinal": cardinal,
            "decan": decan,
            "standard": now_dt.strftime("%H:%M:%S")
        }

    # 2. Meeus Synodic Lunation & Moonphase
    jd = unix_ts / 86400.0 + 2440587.5
    lunation_num = int(math.floor((jd - 2451550.09766) / 29.530588861))

    diff = now_dt - datetime(2001, 1, 1)
    days = diff.days + (diff.seconds / 86400.0)
    lunations = 0.20439731 + (days * 0.03386319269)
    pos = lunations % 1.0

    illum = round((1.0 - math.cos(pos * 2.0 * math.pi)) / 2.0 * 100.0, 1)
    phase_idx = int(math.floor(pos * 8.0 + 0.5)) & 7
    phases_en = ["New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous",
                 "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent"]
    phases_cz = ["Nov", "Dorůstající srpek", "První čtvrť", "Dorůstající Měsíc",
                 "Úplněk", "Ubývající Měsíc", "Poslední čtvrť", "Ubývající srpek"]
    icons = ["🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"]

    return {
        "unix_ts": unix_ts,
        "cet_str": now_dt.strftime("%Y-%m-%d %H:%M:%S"),
        "cet_date": now_dt.strftime("%Y-%m-%d"),
        "cet_time": now_dt.strftime("%H:%M:%S"),
        "dh36": dh_info,
        "lunar": {
            "lunation_number": lunation_num,
            "position": round(pos, 3),
            "illumination_pct": illum,
            "phase_en": phases_en[phase_idx],
            "phase_cz": phases_cz[phase_idx],
            "icon": icons[phase_idx]
        }
    }

