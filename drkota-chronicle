    Generates the authentic "Časové razidlo" (Astrolabe Vector Seal).
    Framed rectangular seal in Golden Ratio proportions: W = 105 mm, H = W / phi ~ 65.0 mm.
    Line height is calibrated to exactly 5.0 mm with crisp, compact typography.
    Optimized for solid, deep inking in the central sweet-spot of the V-plotter.
    """
    h_mm = width_mm / PHI
    paths = []

    # 1. Clean Outer Border (Single framed perimeter)
    paths.append(path_rect(2.0, 2.0, width_mm - 4.0, h_mm - 4.0))

    # 2. Astrolabe Dial (Left Side)
    dial_cx = 22.0
    dial_cy = h_mm / 2.0
    dial_r = 16.5
    azimuth = telemetry["time"]["dh36"]["azimuth_deg"]
    lunar_pos = telemetry["time"]["lunar"]["position"]
    paths.extend(path_astrolabe_dial(dial_cx, dial_cy, dial_r, azimuth, lunar_pos))

    # Vertical divider line between dial and typography
    div_x = 44.0
    paths.append(path_line(div_x, 5.0, div_x, h_mm - 5.0))

    # 3. Typography (Right Side) — Exact 5.0 mm Line Height
    t_x = div_x + 4.0
    y_start = 8.5
    pitch_y = 5.0  # Exact 5mm line height requested by user

    t_data = telemetry["time"]
    g_data = telemetry["grid"]
    h_data = telemetry["heat"]
    w_data = telemetry["weather"]
    branch = telemetry.get("scenario", "CANONICAL")

    lines = [
        ("OBSERVATOŘ // ČASOVÉ RAZIDLO", 1.6, 2.7),
        (f"ČAS : {t_data['cet_str']} CET", 1.4, 2.3),
        (f"DH36: {t_data['dh36']['str']} (DEKAN {t_data['dh36']['decan']:02d})", 1.3, 2.2),
        (f"AZIM: {t_data['dh36']['azimuth_deg']:.1f}° {t_data['dh36']['cardinal'][:10]}", 1.3, 2.2),
        (f"LUNA: {t_data['lunar']['lunation_number']}. LUNACE | {t_data['lunar']['illumination_pct']}%", 1.3, 2.2),
        (f"SÍŤ : {g_data['freq_hz']:.3f} HZ (Δ {g_data['drift_mhz']:+.1f} MHZ)", 1.3, 2.2),
        (f"OTOP: {h_data['total_units']:.0f} HCA | {h_data['total_meters']} MĚŘIDEL", 1.3, 2.2),
        (f"METEO: {w_data['temp_c']:+.1f}°C | {w_data['pressure_hpa']:.0f} HPA", 1.3, 2.2),
        ("--TÉCHNĒ & KOF // DRKOTA", 1.2, 2.0),
    ]

    for idx, (txt, cw, ch) in enumerate(lines):
        cur_y = y_start + idx * pitch_y
        paths.extend(render_text_strokes(txt, t_x, cur_y, char_w=cw, char_h=ch))

    # Decorative horizontal divider under title
    paths.append(path_line(t_x, y_start + 3.8, width_mm - 5.0, y_start + 3.8))

    # Assemble SVG
    d_attr = " ".join(paths)
    svg = (
        f'<?xml version="1.0" encoding="UTF-8"?>\n'
        f'<svg width="{width_mm:.2f}mm" height="{h_mm:.2f}mm" viewBox="0 0 {width_mm:.2f} {h_mm:.2f}" '
        f'xmlns="http://www.w3.org/2000/svg">\n'
        f'  <g id="casove_razidlo">\n'
        f'    <path d="{d_attr}" stroke="black" stroke-width="0.30" fill="none" stroke-linecap="round" stroke-linejoin="round" />\n'
        f'  </g>\n'
        f'</svg>\n'
    )
    return svg, width_mm, h_mm

def generate_strip_svg(telemetry, width_mm=140.0, height_mm=210.0):
    """
    Generates a 3-track seismograph strip:
      - Header stamp at top
