      - Track 2: Weather curves (temperature & pressure)
      - Track 3: Wireless M-Bus radiator heat pulse bars (19 meters)
      - Footer stamp
    """
    paths = []

    # Outer border
    paths.append(path_rect(2.0, 2.0, width_mm - 4.0, height_mm - 4.0))

    # 1. Header Stamp Block (Top: 5 to 44 mm)
    # Compact Astrolabe Dial at Left
    header_cx = 24.0
    header_cy = 23.5
    header_r = 16.5
    azimuth = telemetry["time"]["dh36"]["azimuth_deg"]
    lunar_pos = telemetry["time"]["lunar"]["position"]
    paths.extend(path_astrolabe_dial(header_cx, header_cy, header_r, azimuth, lunar_pos))

    # Header Telemetry Text (Right)
    ht_x = 46.0
    paths.extend(render_text_strokes("DRKOTA CHRONICLE // 3-TRACK SEISMOGRAPH", ht_x, 8.0, char_w=1.7, char_h=2.4))
    paths.append(path_line(ht_x, 11.5, width_mm - 6.0, 11.5))
    paths.extend(render_text_strokes(f"ČAS : {telemetry['time']['cet_str']} CET", ht_x, 14.5, char_w=1.4, char_h=2.1))
    paths.extend(render_text_strokes(f"DH36: {telemetry['time']['dh36']['str']} (DEKAN {telemetry['time']['dh36']['decan']:02d})", ht_x, 19.5, char_w=1.4, char_h=2.1))
    paths.extend(render_text_strokes(f"LUNA: {telemetry['time']['lunar']['lunation_number']}. LUNACE ({telemetry['time']['lunar']['illumination_pct']}%)", ht_x, 24.5, char_w=1.4, char_h=2.1))
    paths.extend(render_text_strokes(f"SÍŤ : {telemetry['grid']['freq_hz']:.3f} HZ | OTOP: {telemetry['heat']['total_units']:.0f} HCA", ht_x, 29.5, char_w=1.4, char_h=2.1))
    paths.extend(render_text_strokes(f"METEO: {telemetry['weather']['temp_c']:+.1f}°C | {telemetry['weather']['pressure_hpa']:.0f} HPA", ht_x, 34.5, char_w=1.4, char_h=2.1))
    paths.extend(render_text_strokes(f"VĚTEV: {telemetry.get('scenario', 'CANONICAL')}", ht_x, 39.5, char_w=1.3, char_h=1.9))

    # Divider bar
    paths.append(path_line(4.0, 44.5, width_mm - 4.0, 44.5))
    paths.append(path_line(4.0, 45.3, width_mm - 4.0, 45.3))

    # 2. Track 1: Grid 50Hz Seismograph (Y: 48 to 92 mm)
    t1_top = 48.0
    t1_h = 44.0
    t1_mid = t1_top + t1_h / 2.0
    paths.append(path_rect(6.0, t1_top, width_mm - 12.0, t1_h))
    paths.extend(render_text_strokes("[STOPA 1: SÍŤ 50 HZ FREKVENCE & MIKRO-DEVIACE]", 9.0, t1_top + 3.0, char_w=1.4, char_h=2.0))
    paths.extend(render_text_strokes("OSA X: 1 DH = 40 MIN", width_mm - 44.0, t1_top + 3.0, char_w=0.9, char_h=1.4))

    # Grid baseline (50.000 Hz)
    paths.append(path_line(24.0, t1_mid, width_mm - 8.0, t1_mid))
    # Threshold dashed guidelines (+20, +50, -20, -50 mHz)
    for mhz, label in [(+50, "+50"), (+20, "+20"), (-20, "-20"), (-50, "-50")]:
        y_pos = t1_mid - (mhz / 50.0) * (t1_h * 0.33)
        # dashed line
        x_cur = 24.0
        while x_cur < width_mm - 8.0:
            paths.append(path_line(x_cur, y_pos, min(x_cur + 2.5, width_mm - 8.0), y_pos))
            x_cur += 5.0
        paths.extend(render_text_strokes(label, 9.0, y_pos - 1.0, char_w=1.1, char_h=1.7))

    paths.extend(render_text_strokes("50.0", 9.0, t1_mid - 1.0, char_w=1.1, char_h=1.7))

    # Seismograph trace wave
    cur_drift = telemetry["grid"]["drift_mhz"]
    trace_pts = []
    num_pts = 64
    x_timeline_w = width_mm - 34.0
    x_step = x_timeline_w / float(num_pts)
    # Synthetic / inertia Markov walk seeded around actual drift
    drift_val = cur_drift
    for i in range(num_pts + 1):
        xp = 25.0 + i * x_step
        # Smooth wander
        delta = math.sin(i * 0.35) * 6.0 + math.cos(i * 0.18) * 4.0
        drift_point = drift_val + delta
        # Clamp to +- 50 mHz range
        clamped = max(-55.0, min(55.0, drift_point))
        yp = t1_mid - (clamped / 50.0) * (t1_h * 0.33)
        trace_pts.append((xp, yp))

    d_trace = f"M {trace_pts[0][0]:.2f},{trace_pts[0][1]:.2f} " + " ".join(f"L {p[0]:.2f},{p[1]:.2f}" for p in trace_pts[1:])
    paths.append(d_trace)

    # Track 1: Time on X-Axis (1 DH = 40 min = 2400 s)
    t1_ax_y = t1_top + t1_h - 4.2
    paths.append(path_line(24.0, t1_ax_y, width_mm - 8.0, t1_ax_y))
    cur_ts = telemetry["time"].get("timestamp", time.time())
    for i in range(9):
        tx = 25.0 + (i / 8.0) * x_timeline_w
        is_major = (i % 2 == 0)
        tick_len = 1.8 if is_major else 0.9
        paths.append(path_line(tx, t1_ax_y, tx, t1_ax_y - tick_len))
        if is_major:
            dt_sec = (8 - i) * 300  # 40m, 30m, 20m, 10m, 0m
            t_dt = datetime.fromtimestamp(cur_ts - dt_sec)
            t_clock = t_dt.strftime("%H:%M")
            if i == 0:
                paths.extend(render_text_strokes(f"{t_clock} (-40M)", tx, t1_ax_y + 1.2, char_w=0.9, char_h=1.4, align="left"))
            elif i == 4:
                paths.extend(render_text_strokes(f"{t_clock} (-20M)", tx, t1_ax_y + 1.2, char_w=0.9, char_h=1.4, align="center"))
            elif i == 8:
                paths.extend(render_text_strokes(f"{t_clock} [NYNÍ]", tx, t1_ax_y + 1.2, char_w=0.9, char_h=1.4, align="right"))
            else:
                paths.extend(render_text_strokes(f"-{dt_sec // 60}M", tx, t1_ax_y + 1.2, char_w=0.8, char_h=1.3, align="center"))

    # 3. Track 2: Weather Seismograph (Y: 96 to 140 mm)
    t2_top = 96.0
    t2_h = 44.0
    t2_mid = t2_top + t2_h / 2.0
    paths.append(path_rect(6.0, t2_top, width_mm - 12.0, t2_h))
    paths.extend(render_text_strokes("[STOPA 2: METEO PRAHA - TEPLOTA & TLAK VZDUCHU]", 9.0, t2_top + 3.0, char_w=1.4, char_h=2.0))
    paths.extend(render_text_strokes("OSA X: HISTORIE 24 HODIN", width_mm - 48.0, t2_top + 3.0, char_w=0.9, char_h=1.4))

    # Axes
    paths.extend(render_text_strokes("20°C", 9.0, t2_top + 8.0, char_w=1.1, char_h=1.6))
    paths.extend(render_text_strokes("10°C", 9.0, t2_mid - 0.8, char_w=1.1, char_h=1.6))
    paths.extend(render_text_strokes(" 0°C", 9.0, t2_top + t2_h - 7.5, char_w=1.1, char_h=1.6))

    paths.extend(render_text_strokes("1010hPa", width_mm - 26.0, t2_top + 8.0, char_w=1.0, char_h=1.5))
    paths.extend(render_text_strokes(" 980hPa", width_mm - 26.0, t2_mid - 0.8, char_w=1.0, char_h=1.5))
    paths.extend(render_text_strokes(" 950hPa", width_mm - 26.0, t2_top + t2_h - 7.5, char_w=1.0, char_h=1.5))

    # Temperature Curve (Solid)
    temp_base = telemetry["weather"]["temp_c"]
    temp_pts = []
    for i in range(num_pts + 1):
        xp = 25.0 + i * x_step
        t_var = temp_base + math.sin(i * 0.22) * 2.5
        norm_t = (t_var - 0.0) / 20.0  # 0..20 deg
        yp = (t2_top + t2_h - 8.5) - norm_t * (t2_h - 17.0)
        temp_pts.append((xp, yp))
    paths.append(f"M {temp_pts[0][0]:.2f},{temp_pts[0][1]:.2f} " + " ".join(f"L {p[0]:.2f},{p[1]:.2f}" for p in temp_pts[1:]))

    # Pressure Curve (Dashed)
    press_base = telemetry["weather"]["pressure_hpa"]
    press_pts = []
    for i in range(num_pts + 1):
        xp = 25.0 + i * x_step
        p_var = press_base + math.cos(i * 0.15) * 5.0
        norm_p = (p_var - 950.0) / 60.0  # 950..1010 hPa
        yp = (t2_top + t2_h - 8.5) - norm_p * (t2_h - 17.0)
        press_pts.append((xp, yp))
    for i in range(0, len(press_pts) - 1, 2):
        paths.append(path_line(press_pts[i][0], press_pts[i][1], press_pts[i+1][0], press_pts[i+1][1]))

    # Track 2: Time on X-Axis (24-hour Diurnal History)
    t2_ax_y = t2_top + t2_h - 4.2
    paths.append(path_line(24.0, t2_ax_y, width_mm - 8.0, t2_ax_y))
    for i in range(9):
        tx = 25.0 + (i / 8.0) * x_timeline_w
        is_major = (i % 2 == 0)
        tick_len = 1.8 if is_major else 0.9
        paths.append(path_line(tx, t2_ax_y, tx, t2_ax_y - tick_len))
        if is_major:
            dh_hours = (8 - i) * 3  # 24h, 18h, 12h, 6h, 0h
            t_dt = datetime.fromtimestamp(cur_ts - dh_hours * 3600)
            t_clock = t_dt.strftime("%H:%M")
            if i == 0:
                paths.extend(render_text_strokes(f"{t_clock} (-24H)", tx, t2_ax_y + 1.2, char_w=0.9, char_h=1.4, align="left"))
            elif i == 4:
                paths.extend(render_text_strokes(f"{t_clock} (-12H)", tx, t2_ax_y + 1.2, char_w=0.9, char_h=1.4, align="center"))
            elif i == 8:
                paths.extend(render_text_strokes(f"{t_clock} [NYNÍ]", tx, t2_ax_y + 1.2, char_w=0.9, char_h=1.4, align="right"))
            else:
                paths.extend(render_text_strokes(f"-{dh_hours}H", tx, t2_ax_y + 1.2, char_w=0.8, char_h=1.3, align="center"))

    # 4. Track 3: Wireless M-Bus Radiator Heat Pulses (Y: 144 to 194 mm)
    t3_top = 144.0
    t3_h = 50.0
    t3_base_y = t3_top + t3_h - 8.0
    paths.append(path_rect(6.0, t3_top, width_mm - 12.0, t3_h))
    paths.extend(render_text_strokes(f"[STOPA 3: OTOP - 19 MĚŘIDEL WIRELESS M-BUS (CELKEM {telemetry['heat']['total_units']:.0f} HCA)]", 9.0, t3_top + 3.0, char_w=1.4, char_h=2.0))
    paths.extend(render_text_strokes("OSA X: 19 MĚŘIDEL V SÍTI", width_mm - 48.0, t3_top + 3.0, char_w=0.9, char_h=1.4))

    # Baseline for meters
    paths.append(path_line(12.0, t3_base_y, width_mm - 12.0, t3_base_y))

    meters = telemetry["heat"]["meters"][:19]
    max_hca = max([m.get("last_hca", 100.0) for m in meters] + [300.0])
    bar_pitch = (width_mm - 28.0) / 19.0

    for i, m in enumerate(meters):
        bx = 15.0 + i * bar_pitch
        hca = float(m.get("last_hca", 0.0))
        bh = (hca / max_hca) * 32.0
        # Draw vertical pulse impulse bar with needle head
        by_top = t3_base_y - bh
        paths.append(path_line(bx, t3_base_y, bx, by_top))
        # Top needle tick
        paths.append(path_line(bx - 1.2, by_top, bx + 1.2, by_top))
        # Meter tick on baseline
        paths.append(path_line(bx, t3_base_y, bx, t3_base_y + 1.8))
        # Label every 2nd meter
        if i % 2 == 0:
            paths.extend(render_text_strokes(f"{i+1:02d}", bx, t3_base_y + 3.2, char_w=0.9, char_h=1.4, align="center"))

    # 5. Footer (Y: 198 to 207 mm)
    paths.append(path_line(4.0, 197.0, width_mm - 4.0, 197.0))
    paths.extend(render_text_strokes("DRKOTA CHRONICLE // OBSERVATOŘ CYBERNETICS // --TÉCHNĒ & KOF", 8.0, 201.5, char_w=1.4, char_h=2.0))
    paths.extend(render_text_strokes(f"PHI = {PHI:.4f}", width_mm - 32.0, 201.5, char_w=1.3, char_h=1.9))

    # Assemble SVG
    d_attr = " ".join(paths)
    svg = (
        f'<?xml version="1.0" encoding="UTF-8"?>\n'
        f'<svg width="{width_mm:.2f}mm" height="{height_mm:.2f}mm" viewBox="0 0 {width_mm:.2f} {height_mm:.2f}" '
        f'xmlns="http://www.w3.org/2000/svg">\n'
        f'  <g id="drkota_seismograph_strip">\n'
        f'    <path d="{d_attr}" stroke="black" stroke-width="0.25" fill="none" stroke-linecap="round" stroke-linejoin="round" />\n'
        f'  </g>\n'
        f'</svg>\n'
    )
    return svg, width_mm, height_mm

