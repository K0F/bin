#!/bin/zsh
CONV="b33c5c75-6602-4240-b7d6-3761ba2807f3"
CURRENT_HOST="$(hostname)"

if [[ "$CURRENT_HOST" == "boxC" || "$CURRENT_HOST" == "bazina" || "$CURRENT_HOST" == "B" ]] && command -v agy >/dev/null 2>&1; then
    exec agy --conversation="$CONV" "$@"
elif [ -x "$HOME/bin/af" ]; then
    exec "$HOME/bin/af" --conversation="$CONV" "$@"
else
    exec ssh -p 2222 -t home "tmux new-session -A -s agy agy --conversation=$CONV $*"
fi
