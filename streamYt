#! /bin/bash
#
# Diffusion youtube avec ffmpeg

# Configurer youtube avec une résolution 720p. La vidéo n'est pas scalée.

VBR="2500k" # Bitrate de la vidéo en sortie
FPS="30" # FPS de la vidéo en sortie
QUAL="medium" # Preset de qualité FFMPEG
YOUTUBE_URL="rtmp://a.rtmp.youtube.com/live2" # URL de base RTMP youtube

KEY="krystof.pesek.857c-as2t-w3jm-14c9" # Clé à récupérer sur l'event youtube

ffmpeg \
         -f jack -ac 2 -i STREAM_IN -f x11grab -show_region 1 -s 800x480 -r 25 -i :0.0  -metadata title="Stream by KOF" \
         -vcodec libx264 -pix_fmt yuv420p -preset $QUAL -r $FPS -g $(($FPS * 2)) -b:v $VBR \
         -acodec libmp3lame -ar 44100 -threads 4 -qscale 3 -b:a 712000 -bufsize 512k \
         -f flv "$YOUTUBE_URL/$KEY" 
