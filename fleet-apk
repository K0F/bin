sudo chown -R kof:www-data /var/www/html/apk
sudo chmod -R 775 /var/www/html/apk
EOF

    local full_url="${APK_WEB_URL}/${dest_name}"
    echo "[✓] Published live at: ${APK_HUMAN_URL}/${dest_name} (${full_url})"
    if command -v qrencode >/dev/null 2>&1; then
        echo "--- Scan QR Code to install ${dest_name} on Android ---"
        qrencode -t ANSIUTF8 "$full_url"
    fi
    log_now "Published $dest_name to $full_url"
}

cmd_install() {
    local proj="${1:-}"
    if [ -z "$proj" ]; then
        echo "Usage: fleet-apk install <project>" >&2
        exit 1
    fi
    local proj_dir="$SRC_DIR/$proj"
    local apk_file=""
    for candidate in "$proj_dir/${proj}-release.apk" "$proj_dir/${proj}.apk" "$proj_dir/${proj,,}-release.apk" "$proj_dir/${proj,,}.apk"; do
        if [ -f "$candidate" ]; then
            apk_file="$candidate"
            break
        fi
    done

    if [ -z "$apk_file" ]; then
        echo "Error: No built APK found in $proj_dir. Run 'fleet-apk build $proj' first." >&2
        exit 1
    fi

    # Check local ADB first, then remote node ADB
    if adb get-state >/dev/null 2>&1; then
        echo "== [fleet-apk] Installing $apk_file onto local ADB device on $HOSTNAME_SHORT =="
        adb install -r "$apk_file"
    elif [ "$HOSTNAME_SHORT" != "t520" ] && ssh "$T520_HOST" "adb get-state" >/dev/null 2>&1; then
        echo "== [fleet-apk] Installing $apk_file via ADB on t520 ($T520_HOST) =="
        scp -q "$apk_file" "kof@${T520_HOST}:/tmp/install_target.apk"
        ssh "$T520_HOST" "adb install -r /tmp/install_target.apk && rm -f /tmp/install_target.apk"
    elif [ "$HOSTNAME_SHORT" != "bazina" ] && ssh "$BAZINA_HOST" "adb get-state" >/dev/null 2>&1; then
        echo "== [fleet-apk] Installing $apk_file via ADB on bazina ($BAZINA_HOST) =="
        scp -q "$apk_file" "kof@${BAZINA_HOST}:/tmp/install_target.apk"
        ssh "$BAZINA_HOST" "adb install -r /tmp/install_target.apk && rm -f /tmp/install_target.apk"
    else
        echo "[!] No USB/Wi-Fi ADB device currently attached to t520 or bazina."
        echo "    Use 'fleet-apk publish $proj' to install over HTTPS QR code."
        return 1
    fi
    log_now "Installed $apk_file via ADB"
}

cmd_termux() {
    local sketch_dir="${1:-$PWD}"
    local phone_host="${2:-phone}"
    if [ ! -d "$sketch_dir" ]; then
        echo "Error: Sketch directory $sketch_dir not found." >&2
        exit 1
    fi
    local name
    name="$(basename "$(readlink -f "$sketch_dir")")"
    echo "== [fleet-apk] Syncing Raylib/Processing sketch '$name' to Termux ($phone_host) =="
    ssh -p 8022 "$phone_host" "mkdir -p ~/sketches/$name"
    rsync -avz -e "ssh -p 8022" "$sketch_dir/" "${phone_host}:~/sketches/$name/"
    ssh -p 8022 "$phone_host" "cd ~/src/processing.h && ./runAndroid.sh ~/sketches/$name"
}

ACTION="${1:-}"
shift || true

case "$ACTION" in
    sync-sdk) cmd_sync_sdk "$@" ;;
    build)    cmd_build "$@" ;;
    publish)  cmd_publish "$@" ;;
    install)  cmd_install "$@" ;;
    all)
        proj="${1:-}"
        cmd_build "$proj" release
        cmd_publish "$proj"
        cmd_install "$proj" || true
        ;;
    termux)   cmd_termux "$@" ;;
    *)
        echo "Usage: fleet-apk <sync-sdk|build <proj>|publish <proj>|install <proj>|all <proj>|termux <dir> [host]>" >&2
        exit 1
        ;;
esac
