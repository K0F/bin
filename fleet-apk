for f in *.apk; do
  [ -f "$f" ] || continue
  sz="$(du -h "$f" | awk '{print $1}')"
  dt="$(date -r "$f" '+%Y-%m-%d %H:%M')"
  sha="$(sha256sum "$f" | awk '{print $1}')"
  echo "<tr><td><strong>$f</strong></td><td>$sz</td><td>$dt</td><td class=\"sha\">$sha</td><td><a class=\"btn\" href=\"$f\">STÁHNOUT APK</a></td></tr>" >> index.html
